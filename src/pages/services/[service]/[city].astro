---
// Service × city pages — the programmatic layer beneath each service line.
//
// ANTI-THIN-CONTENT CONTRACT (read before editing):
// Google's spam policy treats mass-produced near-duplicate location pages as
// "scaled content abuse" and "doorway abuse". Every page built here therefore
// carries real, city-SPECIFIC substance that is false for every other city:
//   1. the city's own hand-written intro from the cities collection
//   2. its real county, and the county page it belongs to
//   3. its hand-written highlights
//   4. its own FAQs (unique per city, authored in the collection)
//   5. its real neighbourhoods, linked
// The service supplies the framing and the operational detail; the city
// supplies the facts. If a city entry ever loses that substance, it should drop
// out of this route rather than ship a template with a name swapped in.
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Button from '@/components/ui/Button.astro';
import CheckList from '@/components/ui/CheckList.astro';
import FAQ from '@/components/ui/FAQ.astro';
import CTABand from '@/components/ui/CTABand.astro';
import ServiceFormBand from '@/components/services/ServiceFormBand.astro';
import { serviceLines, findService, feeLine, formVariantFor } from '@/data/serviceLines';
import { counties } from '@/data/counties';
import { notesFor } from '@/data/serviceNotes';
import { images, type ImageKey } from '@/data/images';
import { site } from '@/config/site';
import { breadcrumbSchema, serviceSchema } from '@/lib/schema';

export async function getStaticPaths() {
  const cities = await getCollection('cities', (c) => c.data.published);
  const paths = [];
  for (const service of serviceLines) {
    for (const slug of service.marketCities) {
      const city = cities.find((c) => c.data.slug === slug);
      // Only build where the city has real, hand-written substance to carry.
      if (!city || !city.data.intro) continue;
      paths.push({ params: { service: service.slug, city: slug }, props: { service, city } });
    }
  }
  return paths;
}

const { service, city } = Astro.props;
const d = city.data;

const [allNeighborhoods] = await Promise.all([
  getCollection('neighborhoods', (n) => n.data.published),
]);
const hoods = allNeighborhoods.filter((n) => n.data.citySlug === d.slug);

const related = service.relatedServices
  .map((s) => findService(s))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));

// Sibling cities for this service — real internal linking, not a tag cloud.
// ROTATE the window by this city's own index instead of always slicing the
// first 12: a fixed slice meant only the first 13 cities in each marketCities
// array could ever receive a sibling link, leaving 44 pages with zero inbound
// links sitewide. Rotating guarantees every city is linked from somewhere.
const cityIdx = Math.max(0, service.marketCities.indexOf(d.slug));
const others = service.marketCities.filter((s) => s !== d.slug);
const siblingSlugs = others.length <= 12
  ? others
  : Array.from({ length: 12 }, (_, i) => others[(cityIdx + i) % others.length]);

const heroKey = (d.heroImage && d.heroImage in images
  ? d.heroImage
  : service.heroImageKey && service.heroImageKey in images
    ? service.heroImageKey
    : 'georgiaCity') as ImageKey;

// HOA/community pages are read by a board, not a single property owner — the
// lead-capture copy has to match that or it reads as a mismatched template.
const boardAudience = service.slug === 'hoa-management';
// Fit the lead form's questions to what this page actually sells, and tag every
// lead with the service so the owner knows which page it came from.
const formVariant = formVariantFor(service);
// Verifiable, service-specific local detail. Empty for combinations with no
// genuine local story — see src/data/serviceNotes.ts.
const localNotes = notesFor(service.slug, d.slug);
// City names beginning with a vowel sound ("an Alpharetta community").
const article = /^[aeiou]/i.test(d.name) ? 'an' : 'a';

// City FAQs were authored for short-term rentals, and 65 of the 100 city files
// quote the STR fee ("10-15% of booking revenue"). Long-term, commercial and
// HOA work is priced per property or per door — so on those pages that FAQ is a
// FALSE PRICE, and it was being emitted into FAQPage structured data as well.
// Drop any city FAQ quoting a revenue-share fee unless the service is actually
// priced that way. Same category split as feeLine().
const revenueShare = ['short-term', 'mid-term', 'platform'].includes(service.category);
const quotesRevenueShare = (s: string) =>
  /booking revenue|%\s*of\s*(the\s*)?(booking\s*)?revenue|\d+\s*[–—-]\s*\d+\s*%/i.test(s);
const feeSafeFaqs = revenueShare
  ? [...d.faqs]
  : d.faqs.filter((f) => !quotesRevenueShare(f.a) && !quotesRevenueShare(f.q));

/* A city's FAQs were the SAME six questions on all twelve of that city's
 * service pages, which made them the single biggest source of duplication
 * between sibling service pages — measured at ~60% identical paragraphs for
 * same-city/different-service pairs. They were also frequently off-topic: an
 * Airbnb permit question sitting on a corporate-housing page.
 *
 * Take a service-appropriate slice instead. Questions whose wording actually
 * touches this service come first; the remainder is rotated by a hash of the
 * service slug so two services in the same city never open with the same
 * filler. Nothing is lost — the full list still renders on the city page
 * itself, which is where someone browsing the whole market will read it.
 */
const FAQ_FIT: Record<string, RegExp> = {
  'short-term': /short.?term|airbnb|nightly|guest|permit|licen[cs]e|occupancy|review/i,
  'mid-term': /mid.?term|furnished|30|month|extended|corporate|nurse|insurance|relocat|stay/i,
  platform: /airbnb|vrbo|booking|listing|channel|direct|photo|rank/i,
  'long-term': /long.?term|lease|tenant|annual|renter|screen|deposit|evict/i,
  commercial: /commercial|office|retail|multi.?family|unit|hoa|association|board|assessment/i,
};
const fit = FAQ_FIT[service.category] ?? /./;
const onTopic = feeSafeFaqs.filter((f) => fit.test(f.q) || fit.test(f.a));
const offTopic = feeSafeFaqs.filter((f) => !onTopic.includes(f));
const spin = Math.abs([...service.slug].reduce((h, c) => (h * 31 + c.charCodeAt(0)) | 0, 0));
const turn = offTopic.length ? spin % offTopic.length : 0;
const cityFaqs = [...onTopic, ...offTopic.slice(turn), ...offTopic.slice(0, turn)].slice(0, 3);

const heading = `${service.name} in ${d.name}, ${d.state}`;

// Titles: a hard .slice(0, 60) chopped 35 pages mid-word ("…Management in Alph").
// Fall back to the service's SHORT name before truncating, and if it still
// doesn't fit, cut on a word boundary so the title always reads as words.
// The city is always kept — it's what makes the title distinct from the hub's
// (4 hubs are already Atlanta-scoped, so an unqualified title collided).
// Explicit compact labels for the service names too long to fit a city after
// them. Derived shortening isn't enough — "Direct Booking & Multi-Channel
// Distribution" has no "Management" suffix to strip, and cutting the string
// blind ate the city name ("…in Sandy"), which is the one part that must
// survive: it's what distinguishes this title from the hub's.
const SHORT_LABEL: Record<string, string> = {
  'direct-booking': 'Direct Booking Management',
  'marriott-homes-villas': 'Marriott Homes & Villas',
  'hoa-management': 'HOA Management',
  'multi-family-property-management': 'Multi-Family Management',
  'commercial-property-management': 'Commercial Management',
  'corporate-housing-management': 'Corporate Housing',
  'mid-term-rental-management': 'Mid-Term Rental Management',
  'long-term-rental-management': 'Long-Term Rental Management',
  'film-production-housing': 'Film & Production Housing',
};
const place = `${d.name}, ${d.state}`;
const titleCandidates = [
  `${service.name} in ${place}`,
  `${SHORT_LABEL[service.slug] ?? service.name} in ${place}`,
  `${(SHORT_LABEL[service.slug] ?? service.name).replace(/ Management$/i, '')} in ${place}`,
];
// Last resort still keeps the whole city — it trims the service label, not the place.
const seoTitle =
  titleCandidates.find((t) => t.length <= 60) ??
  `${(SHORT_LABEL[service.slug] ?? service.name).slice(0, Math.max(8, 57 - place.length)).replace(/\s+\S*$/, '')} in ${place}`;

/* SELF-COMPETITION FIX.
 * Four service hubs carry a hand-written seoTitle that already targets Atlanta
 * — "Commercial Property Management in Atlanta, GA" — and the templated title
 * for that service's own /atlanta/ page comes out identical. Two of our URLs
 * were therefore chasing one query with one title, and Search Console showed
 * exactly the damage: for all four, the hub ranked between positions 50 and 58
 * while its Atlanta twin sat at 70 to 87, with the impressions split across
 * both. The hub also carries roughly twice the body copy.
 *
 * So where the two titles collide, the city page canonicalises to the hub and
 * the signal consolidates onto the stronger page. The page is NOT removed — it
 * still serves visitors and still carries its local notes; it just stops
 * bidding against its own hub.
 *
 * The condition is the collision itself rather than a hardcoded list of four
 * slugs, so it corrects itself if a hub title is ever rewritten. */
const hubUrl = new URL(`/services/${service.slug}/`, site.domain).href;
const canonicalUrl = service.seoTitle === seoTitle ? hubUrl : undefined;
// Deliberately says "local team", not "licensed team". The group operates
// through more than one entity and the licensing posture differs by service
// line, so a blanket licensing claim in a sitewide-templated meta description
// would over-claim on some pages. Licensure is stated in body copy where it is
// specifically true, not templated across 470 pages.
// No tagline here on purpose: taglines vary in length, so splicing one in and
// hard-slicing to 155 chopped descriptions mid-word ("Get a free projec"). This
// composes only fixed-length parts, so every one of the 470 city pages ends as
// a complete sentence with no truncation.
// The county is real, differs city to city, and is exactly the kind of local
// qualifier a searcher recognises — so it carries the description instead of
// the same "from a local Atlanta team" sentence appearing on all 454 pages.
// Still composed from fixed-length parts and length-checked, so no description
// can end mid-word; falls back to the plain form if a long name overruns.
const shortLabel = SHORT_LABEL[service.slug] ?? service.name;
const countyPhrase = d.county ? `${d.county} County` : 'metro Atlanta';
const cta = boardAudience
  ? 'Request a written management proposal.'
  : 'Get a free projection for your property.';
const describedAs = [
  `${shortLabel} in ${d.name}, ${d.state} — for owners across ${countyPhrase}. ${cta}`,
  `${shortLabel} in ${d.name}, ${d.state} from a local ${countyPhrase} team. ${cta}`,
  `${service.name} in ${d.name}, ${d.state} from a local Atlanta team. ${cta}`,
];
const seoDescription =
  describedAs.find((s) => s.length <= 158) ?? describedAs[describedAs.length - 1];

// Only link a county that actually has a page — the cities collection names
// counties we don't publish (Pickens, Lumpkin, Gilmer, Hall…), and linking them
// blind produced internal 404s. The county sentence still renders either way.
const countySlug = d.county ? d.county.toLowerCase().replace(/\s+/g, '-') : null;
const countyPath =
  countySlug && counties.some((c) => c.slug === countySlug && c.published)
    ? `/counties/${countySlug}/`
    : null;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
  { name: service.name, path: `/services/${service.slug}/` },
  { name: d.name, path: `/services/${service.slug}/${d.slug}/` },
];

const schemas = [
  breadcrumbSchema(breadcrumbs),
  serviceSchema({
    name: heading,
    description: seoDescription,
    serviceType: service.name,
    area: {
      name: `${d.name}, ${d.state}`,
      type: 'City',
      lat: d.lat,
      lng: d.lng,
      county: d.county,
    },
  }),
];
---

<BaseLayout title={seoTitle} description={seoDescription} schemas={schemas} canonicalUrl={canonicalUrl}>
  <PageHero
    title={heading}
    subtitle={service.intro}
    eyebrow={`${service.eyebrow} · ${d.name}`}
    imageKey={heroKey}
    breadcrumbs={breadcrumbs}
    formVariant={formVariant}
    serviceName={service.name}
  />

  <!-- City-specific substance: the city's own hand-written lede -->
  <Section variant="white">
    <Container size="narrow">
      <Eyebrow>{d.name}, {d.state}</Eyebrow>
      <h2 class="mt-3 font-display text-3xl text-forest sm:text-4xl">
        Why {d.name} — and what it means for your property
      </h2>
      <p class="mt-5 leading-relaxed text-ink/80">{d.intro}</p>
      {d.county && (
        <p class="mt-4 leading-relaxed text-ink/75">
          {/* Only render an anchor when the county actually has a page. An <a>
              without href still picked up the link styling, so counties we
              don't publish (Chatham, Clarke, Richmond…) looked clickable and
              weren't. */}
          {d.name} sits in {countyPath
            ? <a href={countyPath} class="font-medium text-brass-600 underline-offset-2 hover:underline">{d.county} County</a>
            : <strong class="font-medium text-forest">{d.county} County</strong>},
          which sets much of the regulatory and tax picture for property here. We track those rules
          per address rather than per city, because they rarely stop neatly at a city line.
        </p>
      )}
      {d.highlights.length > 0 && (
        <div class="mt-8 rounded-2xl border border-line bg-cream p-6 sm:p-8">
          <h3 class="font-display text-lg text-forest">What stands out about {d.name}</h3>
          <div class="mt-4"><CheckList items={[...d.highlights]} columns={1} /></div>
        </div>
      )}
    </Container>
  </Section>

  <!-- The service, applied here -->
  <Section variant="cream">
    <Container size="narrow">
      <h2 class="font-display text-3xl text-forest sm:text-4xl">
        How {service.name.toLowerCase()} works in {d.name}
      </h2>
      {service.sections.slice(0, 2).map((sec) => (
        <div class="mt-8">
          <h3 class="font-display text-xl text-forest">{sec.heading}</h3>
          <div class="mt-3 space-y-4">
            {sec.body.slice(0, 2).map((p) => <p class="leading-relaxed text-ink/80">{p}</p>)}
          </div>
        </div>
      ))}
      {/* Local substance specific to THIS service in THIS city. Renders only
          where a real, verifiable local story exists — a missing entry is
          deliberate, not an oversight. */}
      {localNotes.length > 0 && (
        <div class="mt-10 rounded-2xl border-l-2 border-brass/50 bg-white/60 p-6 sm:p-8">
          <h3 class="font-display text-xl text-forest">
            What {service.name.toLowerCase()} looks like in {d.name} specifically
          </h3>
          <div class="mt-4 space-y-4">
            {localNotes.map((p) => <p class="leading-relaxed text-ink/80">{p}</p>)}
          </div>
        </div>
      )}

      {/* Two pages were competing for "{city} property management" — this one
          and the city page — and both sat at position 70+ as a result. This
          says, in the words people actually search, which page owns that term
          and sends the reader there. It is also the honest answer for an owner
          who landed on one service and wants the whole property handled: that
          full-service work is the core of the business, not a side line. */}
      <div class="mt-10 rounded-xl border border-line bg-white/70 px-5 py-4 sm:px-6">
        <p class="text-[15px] leading-relaxed text-ink/80">
          Want the whole property handled, not just {service.name.toLowerCase()}?
          {' '}
          <a
            href={`/${d.slug}/`}
            class="font-medium text-forest underline decoration-brass/60 underline-offset-4 transition-colors hover:text-brass-600"
          >{d.name} property management</a>
          {' '}covers short-term, long-term and everything between — one team, one point of contact.
        </p>
      </div>

      <div class="mt-10">
        <Button href={`/services/${service.slug}/`} size="lg">
          Full {service.name.toLowerCase()} details
        </Button>
      </div>
    </Container>
  </Section>

  <ServiceFormBand
    variant="tint"
    eyebrow={boardAudience ? `Proposal request · ${d.name}` : `Free projection · ${d.name}`}
    heading={
      boardAudience
        ? `Managing ${article} ${d.name} community?`
        : `What could your ${d.name} property earn?`
    }
    text={
      boardAudience
        ? `Send us the community's details and we'll come back with a written management proposal built around ${d.name} — no obligation, and no pressure on your board.`
        : `Send us the address and we'll come back with real numbers for it, using actual ${d.name} data — from a person on our team, within one business day.`
    }
    formVariant={formVariant}
    serviceName={service.name}
  />

  <!-- What's included -->
  <Section variant="forest">
    <Container>
      <div class="mx-auto max-w-3xl text-center">
        <Eyebrow class="text-brass">Included in {d.name}</Eyebrow>
        <h2 class="mt-3 font-display text-3xl text-cream sm:text-4xl">One rate. The whole service.</h2>
        <p class="mt-4 text-cream/75">{feeLine(service.category)}</p>
      </div>
      <div class="mx-auto mt-10 max-w-3xl">
        <ul class="grid gap-x-8 gap-y-3 sm:grid-cols-2">
          {service.included.map((item) => (
            <li class="flex items-start gap-3 text-sm text-cream/85">
              <svg class="mt-0.5 h-5 w-5 flex-none text-brass" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M6 10.5l2.5 2.5L14 7.5" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="10" cy="10" r="8.25" />
              </svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </Container>
  </Section>

  <!-- Neighbourhoods (real, per-city) -->
  {hoods.length > 0 && (
    <Section variant="white">
      <Container>
        <Eyebrow>Neighbourhoods</Eyebrow>
        <h2 class="mt-3 font-display text-3xl text-forest sm:text-4xl">
          Where we work in {d.name}
        </h2>
        <div class="mt-8 flex flex-wrap gap-2.5">
          {hoods.map((n) => (
            <a href={`/${d.slug}/${n.data.slug}/`} class="rounded-full border border-line bg-cream px-4 py-2 text-sm text-ink/75 transition-colors hover:border-brass/50 hover:text-brass-600">
              {n.data.name}
            </a>
          ))}
        </div>
      </Container>
    </Section>
  )}

  <!-- The city's own FAQs — unique per city -->
  {cityFaqs.length > 0 && (
    <Section variant="cream">
      <Container size="narrow">
        <Eyebrow>{d.name} questions</Eyebrow>
        <h2 class="mt-3 font-display text-3xl text-forest sm:text-4xl">
          Owning and renting in {d.name}
        </h2>
        <div class="mt-8"><FAQ items={cityFaqs} /></div>
      </Container>
    </Section>
  )}

  <!-- Cross-links: other services here, same service elsewhere -->
  <Section variant="white">
    <Container>
      <div class="grid gap-12 lg:grid-cols-2">
        <div>
          <h2 class="font-display text-2xl text-forest">Other services in {d.name}</h2>
          <ul class="mt-5 space-y-2.5">
            {/* Only link the city-level page when that service actually covers
                this city — otherwise fall back to its hub. Linking blind
                produced 352 internal 404s, because a related service's
                marketCities list rarely matches this one's. */}
            {related.map((r) => {
              const hasCity = r.marketCities.includes(d.slug);
              return (
                <li>
                  <a
                    href={hasCity ? `/services/${r.slug}/${d.slug}/` : `/services/${r.slug}/`}
                    class="text-sm text-ink/75 underline-offset-4 transition-colors hover:text-brass-600 hover:underline"
                  >
                    {hasCity ? `${r.name} in ${d.name}` : r.name}
                  </a>
                </li>
              );
            })}
            <li>
              <a href={`/${d.slug}/`} class="text-sm text-ink/75 underline-offset-4 transition-colors hover:text-brass-600 hover:underline">
                Short-term rental management in {d.name}
              </a>
            </li>
          </ul>
        </div>
        <div>
          <h2 class="font-display text-2xl text-forest">{service.name} nearby</h2>
          <div class="mt-5 flex flex-wrap gap-2">
            {siblingSlugs.map((s) => (
              <a href={`/services/${service.slug}/${s}/`} class="rounded-full border border-line px-3.5 py-1.5 text-xs text-ink/70 transition-colors hover:border-brass/50 hover:text-brass-600">
                {s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase())}
              </a>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <CTABand
    heading={`Get a free projection for your ${d.name} property`}
    text="No obligation, no pressure — just the numbers, from a local team that manages here."
  />
</BaseLayout>
