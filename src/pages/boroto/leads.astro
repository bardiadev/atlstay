---
// Lead Desk — the workspace.
//
// PERFORMANCE CONTRACT: the entire dataset is fetched ONCE on load and held in
// memory. Filtering, searching, switching inbox and opening a record touch no
// network at all, and status changes render instantly then sync in the
// background. An early build re-queried the database on every click, which is
// what made it feel laggy — do not reintroduce a fetch into any interaction
// handler.
//
// New data is a different matter. Leads arrive while the desk sits open, and
// requiring a manual Refresh to see one is indistinguishable from the lead
// being lost. So the list quietly re-checks on a timer as well as on the
// button and on returning to the tab — never while a record is open, and never
// while something is being typed.
//
// TWO INBOXES: real enquiries (kind='lead') and general contact-page messages
// (kind='message') — vendor pitches, questions, recruiters. They need totally
// different handling, so they are separated on arrival and can be moved either
// way from the record itself.
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Lead Desk" description="Private lead workspace." noindex={true} bare={true}>
  <div class="min-h-screen bg-[#f6f5f1] text-[#1a2420]">

    <header class="sticky top-0 z-20 border-b border-[#e2e0d6] bg-white">
      <div class="mx-auto flex max-w-[1400px] flex-wrap items-center gap-x-6 gap-y-2 px-5 py-3">
        <span class="font-display text-lg text-forest">Lead Desk</span>
        <nav id="nav" class="flex items-center gap-1 text-sm"></nav>
        <div class="ml-auto flex items-center gap-2">
          <span id="synced" class="mr-1 hidden text-xs text-[#9aa39e] sm:inline"></span>
          <button id="refreshBtn" title="Check for new leads and messages"
            class="inline-flex items-center gap-1.5 rounded-md border border-[#d8d5c8] bg-white px-3 py-1.5 text-sm font-medium text-forest transition-colors hover:border-brass hover:bg-[#fdfbf5] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-forest disabled:opacity-60">
            <svg id="refreshIcon" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/>
            </svg>
            <span id="refreshLabel">Refresh</span>
          </button>
          <button id="addBtn" class="rounded-md border border-[#d8d5c8] bg-white px-3 py-1.5 text-sm font-medium text-forest transition-colors hover:border-brass hover:bg-[#fdfbf5] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-forest">Add lead</button>
          <a href="/boroto/logout" class="text-sm text-[#5b6660] hover:text-forest">Sign out</a>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-[1400px] px-5 py-6">
      <div id="app" aria-live="polite">
        <p class="py-16 text-center text-sm text-[#5b6660]">Loading…</p>
      </div>
    </main>
  </div>

  <!-- ─── Add lead ───────────────────────────────────────────────────────────
       Replaces a chain of five browser prompt() dialogs — no field labels, no
       validation, silently dropped anything you cancelled out of, and never
       touched Telegram at all. A <dialog> gets a real focus trap and Esc-to-
       close for free; fields mirror exactly what an organic submission carries
       (contact details, what they said, where it came from, service interest,
       when it actually arrived) so a hand-keyed lead looks and behaves like a
       real one everywhere else in the system. -->
  <dialog id="addDialog" class="w-full max-w-2xl rounded-2xl border border-[#e2e0d6] bg-white p-0 shadow-2xl backdrop:bg-forest/40 backdrop:backdrop-blur-sm">
    <form id="addForm" method="dialog" class="flex max-h-[88vh] flex-col">
      <div class="flex items-center justify-between border-b border-[#eeece3] px-6 py-4">
        <h2 class="font-display text-xl text-forest">Add a lead</h2>
        <button type="button" id="addClose" aria-label="Close"
          class="rounded-md p-1.5 text-[#9aa39e] transition-colors hover:bg-[#f1efe7] hover:text-forest focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-forest">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>

      <div class="min-h-0 flex-1 space-y-6 overflow-y-auto px-6 py-5">
        <p id="addError" role="alert" class="hidden rounded-lg border border-[#e6cbc8] bg-[#fdeceb] px-3.5 py-2.5 text-sm text-[#a3231b]"></p>

        <!-- Who -->
        <fieldset class="grid gap-4 sm:grid-cols-2">
          <legend class="sr-only">Contact</legend>
          <div class="sm:col-span-2">
            <label for="af-name" class="block text-xs uppercase tracking-wide text-[#5b6660]">Name <span class="text-[#a3231b]">*</span></label>
            <input id="af-name" name="name" required autofocus placeholder="Jane Smith"
              class="mt-1.5 w-full rounded-lg border border-[#e2e0d6] px-3 py-2 text-sm outline-none focus:border-brass focus:ring-2 focus:ring-brass/30" />
          </div>
          <div>
            <label for="af-email" class="block text-xs uppercase tracking-wide text-[#5b6660]">Email</label>
            <input id="af-email" name="email" type="email" placeholder="jane@example.com"
              class="mt-1.5 w-full rounded-lg border border-[#e2e0d6] px-3 py-2 text-sm outline-none focus:border-brass focus:ring-2 focus:ring-brass/30" />
          </div>
          <div>
            <label for="af-phone" class="block text-xs uppercase tracking-wide text-[#5b6660]">Phone</label>
            <input id="af-phone" name="phone" type="tel" placeholder="(678) 555-0100"
              class="mt-1.5 w-full rounded-lg border border-[#e2e0d6] px-3 py-2 text-sm outline-none focus:border-brass focus:ring-2 focus:ring-brass/30" />
          </div>
        </fieldset>

        <!-- The property + what they want -->
        <fieldset class="grid gap-4 sm:grid-cols-2">
          <legend class="sr-only">The property</legend>
          <div class="sm:col-span-2">
            <label for="af-address" class="block text-xs uppercase tracking-wide text-[#5b6660]">Property / community address</label>
            <input id="af-address" name="address" placeholder="123 Peachtree St NE, Atlanta, GA"
              class="mt-1.5 w-full rounded-lg border border-[#e2e0d6] px-3 py-2 text-sm outline-none focus:border-brass focus:ring-2 focus:ring-brass/30" />
          </div>
          <div class="sm:col-span-2">
            <label for="af-service" class="block text-xs uppercase tracking-wide text-[#5b6660]">Service interest</label>
            <input id="af-service" name="service_interest" list="af-service-list" placeholder="e.g. HOA & Community Association Management"
              class="mt-1.5 w-full rounded-lg border border-[#e2e0d6] px-3 py-2 text-sm outline-none focus:border-brass focus:ring-2 focus:ring-brass/30" />
            <datalist id="af-service-list">
              <option value="Airbnb / Short-Term Rental Management"></option>
              <option value="Long-Term Rental Management"></option>
              <option value="Tenant Placement"></option>
              <option value="HOA & Community Association Management"></option>
              <option value="Commercial Property Management"></option>
              <option value="Multi-Family Property Management"></option>
              <option value="Investor Services"></option>
              <option value="Mid-Term Rental Management"></option>
              <option value="Corporate Housing Management"></option>
              <option value="Travel Nurse Housing Management"></option>
              <option value="Insurance & ALE Housing Management"></option>
              <option value="Film & Production Housing"></option>
              <option value="Student & Academic Housing"></option>
              <option value="Vrbo Property Management"></option>
              <option value="Homes & Villas by Marriott Bonvoy Listing Management"></option>
              <option value="Direct Booking & Multi-Channel Distribution"></option>
            </datalist>
          </div>
        </fieldset>

        <!-- What they said vs. what only the team should see -->
        <fieldset class="grid gap-4">
          <legend class="sr-only">Message and notes</legend>
          <div>
            <label for="af-message" class="block text-xs uppercase tracking-wide text-[#5b6660]">What they said</label>
            <textarea id="af-message" name="message" rows="2" placeholder="e.g. Wants a projection for a 3-bed condo, hoping to list next month"
              class="mt-1.5 w-full resize-y rounded-lg border border-[#e2e0d6] px-3 py-2 text-sm outline-none focus:border-brass focus:ring-2 focus:ring-brass/30"></textarea>
            <p class="mt-1 text-xs text-[#9aa39e]">Shown on the Telegram card, the same as a real submission's message.</p>
          </div>
          <div>
            <label for="af-notes" class="block text-xs uppercase tracking-wide text-[#5b6660]">Internal notes</label>
            <textarea id="af-notes" name="notes" rows="2" placeholder="Context for the team only"
              class="mt-1.5 w-full resize-y rounded-lg border border-[#e2e0d6] px-3 py-2 text-sm outline-none focus:border-brass focus:ring-2 focus:ring-brass/30"></textarea>
            <p class="mt-1 text-xs text-[#9aa39e]">Dashboard only — never sent to Telegram.</p>
          </div>
        </fieldset>

        <!-- Where + which site + which inbox -->
        <fieldset class="grid gap-4 sm:grid-cols-2">
          <legend class="sr-only">Source</legend>
          <div class="sm:col-span-2">
            <label for="af-source" class="block text-xs uppercase tracking-wide text-[#5b6660]">Where did this come from?</label>
            <input id="af-source" name="source" list="af-source-list" placeholder="e.g. Phone call, referral, forwarded email"
              class="mt-1.5 w-full rounded-lg border border-[#e2e0d6] px-3 py-2 text-sm outline-none focus:border-brass focus:ring-2 focus:ring-brass/30" />
            <datalist id="af-source-list">
              <option value="Phone call"></option>
              <option value="Referral"></option>
              <option value="Forwarded email"></option>
              <option value="Walk-in / in person"></option>
              <option value="atlstay.com"></option>
              <option value="ssmproperty.com"></option>
              <option value="Zillow"></option>
              <option value="Facebook / Instagram"></option>
            </datalist>
          </div>
          <div>
            <label for="af-brand" class="block text-xs uppercase tracking-wide text-[#5b6660]">Site</label>
            <select id="af-brand" name="brand"
              class="mt-1.5 w-full rounded-lg border border-[#e2e0d6] bg-white px-3 py-2 text-sm outline-none focus:border-brass focus:ring-2 focus:ring-brass/30">
              <option value="ATLStay">ATLStay</option>
              <option value="SSMProperty">SSMProperty</option>
            </select>
          </div>
          <div>
            <label for="af-kind" class="block text-xs uppercase tracking-wide text-[#5b6660]">Inbox</label>
            <select id="af-kind" name="kind"
              class="mt-1.5 w-full rounded-lg border border-[#e2e0d6] bg-white px-3 py-2 text-sm outline-none focus:border-brass focus:ring-2 focus:ring-brass/30">
              <option value="lead">Leads</option>
              <option value="message">Messages</option>
            </select>
          </div>
        </fieldset>

        <!-- When -->
        <fieldset class="grid gap-4 sm:grid-cols-2">
          <legend class="sr-only">When it came in</legend>
          <div>
            <label for="af-date" class="block text-xs uppercase tracking-wide text-[#5b6660]">Date received</label>
            <input id="af-date" name="date" type="date"
              class="mt-1.5 w-full rounded-lg border border-[#e2e0d6] px-3 py-2 text-sm outline-none focus:border-brass focus:ring-2 focus:ring-brass/30" />
          </div>
          <div>
            <label for="af-time" class="block text-xs uppercase tracking-wide text-[#5b6660]">Time received (Eastern)</label>
            <input id="af-time" name="time" type="time"
              class="mt-1.5 w-full rounded-lg border border-[#e2e0d6] px-3 py-2 text-sm outline-none focus:border-brass focus:ring-2 focus:ring-brass/30" />
          </div>
          <p id="af-when-preview" class="sm:col-span-2 text-xs text-[#9aa39e]"></p>
        </fieldset>

        <label class="flex items-start gap-2.5 rounded-lg border border-[#e2e0d6] bg-[#faf9f5] px-3.5 py-3 text-sm text-[#3c4742]">
          <input id="af-telegram" type="checkbox" checked
            class="mt-0.5 h-4 w-4 rounded border-[#c9c6b6] text-forest focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-forest" />
          <span>Post this to the Telegram group, the same as a real lead<span class="block text-xs text-[#9aa39e]">Turn off for old backlog entries you don't want to re-announce.</span></span>
        </label>
      </div>

      <div class="flex items-center justify-end gap-2.5 border-t border-[#eeece3] px-6 py-4">
        <button type="button" id="addCancel"
          class="rounded-md border border-[#d8d5c8] bg-white px-4 py-2 text-sm font-medium text-forest transition-colors hover:border-brass hover:bg-[#fdfbf5] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-forest">Cancel</button>
        <button type="submit" id="addSubmit"
          class="rounded-md bg-forest px-4 py-2 text-sm font-medium text-cream transition-colors hover:bg-forest-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-forest disabled:opacity-60">Add lead</button>
      </div>
    </form>
  </dialog>

  <script is:inline>
  (() => {
    const API = '/boroto/api';
    const $ = (s, r = document) => r.querySelector(s);
    const esc = (v) => String(v ?? '').replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

    /* Status is never conveyed by colour alone — each carries an icon and a
       label as well, and every colour clears 4.5:1 on white. */
    const STATUS = {
      new:           { label: 'New',           fg: '#1d4ed8', bg: '#eef4ff', bd: '#c7dbff', icon: 'M12 7v5l3 2M12 21a9 9 0 1 1 0-18 9 9 0 0 1 0 18' },
      proposal_sent: { label: 'Proposal sent', fg: '#92400e', bg: '#fdf3e3', bd: '#f0dcb4', icon: 'm3 12 18-8-8 18-2-8-8-2Z' },
      won:           { label: 'Won',           fg: '#15803d', bg: '#eaf6ee', bd: '#c3e6cf', icon: 'm5 12 5 5L20 7' },
      lost:          { label: 'Lost',          fg: '#475569', bg: '#f1f3f5', bd: '#d9dee3', icon: 'M6 6l12 12M18 6 6 18' },
    };
    const ORDER = ['new', 'proposal_sent', 'won', 'lost'];

    /* Mirrors functions/api/_leadEvents.js so the activity trail reads the same
       here as it does on the Telegram card. */
    const ACTIVITY = {
      created:      { icon: '✨', verb: 'came in' },
      called:       { icon: '📞', verb: 'called' },
      texted:       { icon: '💬', verb: 'texted' },
      emailed:      { icon: '✉️', verb: 'emailed' },
      proposal:     { icon: '📤', verb: 'sent the proposal' },
      won:          { icon: '✅', verb: 'marked it won' },
      lost:         { icon: '❌', verb: 'marked it lost' },
      replied:      { icon: '↩️', verb: 'replied' },
      not_relevant: { icon: '🚫', verb: 'marked it not relevant' },
      moved:        { icon: '📥', verb: 'moved it to Leads' },
      note:         { icon: '📝', verb: 'noted' },
    };
    const ICONS = {
      mail:    'M3 5h18v14H3z M3 6l9 7 9-7',
      inbox:   'M3 5h18v14H3z M3 13h5l1 3h6l1-3h5',
      back:    'M15 18l-6-6 6-6',
      external:'M14 4h6v6M20 4l-9 9M18 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6',
      arrow:   'M5 12h14 M13 6l6 6-6 6',
    };

    const icon = (d, cls = 'h-3.5 w-3.5') =>
      `<svg class="${cls}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d}"/></svg>`;

    const badge = (st) => {
      const s = STATUS[st] || STATUS.lost;
      return `<span class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full border px-2.5 py-1 text-xs font-medium"
        style="color:${s.fg};background:${s.bg};border-color:${s.bd}">${icon(s.icon, 'h-3 w-3')}${s.label}</span>`;
    };

    /* Every timestamp is shown in Eastern — the owner's own working time. */
    const EST = { timeZone: 'America/New_York', month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit', hour12: true };
    const stamp = (iso) => { if (!iso) return ''; const d = new Date(iso); return isNaN(d) ? iso : d.toLocaleString('en-US', EST) + ' EST'; };
    const shortStamp = (iso) => { if (!iso) return ''; const d = new Date(iso); return isNaN(d) ? iso :
      d.toLocaleString('en-US', { timeZone: 'America/New_York', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', hour12: true }); };
    const clockStamp = (ms) => new Date(ms).toLocaleString('en-US', { timeZone: 'America/New_York', hour: 'numeric', minute: '2-digit', hour12: true });
    const daysSince = (iso) => iso ? Math.floor((Date.now() - new Date(iso)) / 86400000) : null;
    const ago = (iso) => { const d = daysSince(iso); return d === null ? '' : d === 0 ? 'Today' : d === 1 ? 'Yesterday' : d + 'd ago'; };

    let LEADS = [];
    let filter = 'all';
    let query = '';
    let inbox = localStorage.getItem('boroto_inbox') === 'message' ? 'message' : 'lead';
    let busy = false;
    let lastSync = 0;
    let pendingSave = null;   // flushed before any refresh so typing is never lost

    const isMsg = (l) => l.kind === 'message';
    const inInbox = (l) => (inbox === 'message') === isMsg(l);
    const unreadIn = (kind) => LEADS.filter((l) => (kind === 'message') === isMsg(l) && !l.first_viewed_at).length;

    /* The message body as the visitor typed it. */
    const bodyOf = (L) => {
      for (const [k, v] of Object.entries(L.raw_lead || {})) {
        if (/message|comment|how can we help/i.test(k) && String(v ?? '').trim()) return String(v).trim();
      }
      return '';
    };

    /* AirDNA's Rentalizer values one specific address; the old /data/us link
       just opened a market map, which is not what you want when sizing a lead.
       AirDNA geocodes the string itself, so a tidy "street, city, ST, USA" is
       enough. Anything too thin to geocode falls back to the market search. */
    const airdnaUrl = (addr) => {
      const a = String(addr || '').trim().replace(/\s+/g, ' ');
      if (a.length < 8 || !/\d/.test(a)) {
        return 'https://app.airdna.co/data/us?search=' + encodeURIComponent(a);
      }
      const withCountry = /\bUSA?\b|\bUnited States\b/i.test(a) ? a : a + ', USA';
      return 'https://app.airdna.co/data/rentalizer?address=' + encodeURIComponent(withCountry).replace(/%20/g, '+');
    };

    const isQuiet = (l) => l.status === 'proposal_sent' && l.proposal_sent_at && daysSince(l.proposal_sent_at) > 4;

    /* Permanent reference number — never reused, so #0007 always means the
       same enquiry. Older leads imported before numbering show a dash. */
    const ref = (l) => (l.seq ? '#' + String(l.seq).padStart(4, '0') : '—');

    /* Keyed in from the dashboard rather than captured by a form. The server
       writes form_name = 'Added by hand'; the Telegram card marks these too. */
    const isManual = (l) => l.form_name === 'Added by hand';

    /* The most recent thing anyone did, whatever it was. This is what the
       status column shows underneath the badge: a status alone doesn't tell
       you that someone already called an hour ago. */
    const latest = (l) => {
      const evs = (l.events || []).filter((e) => ACTIVITY[e.action]);
      return evs.length ? evs[evs.length - 1] : null;
    };
    const countsOf = (l) => {
      const evs = l.events || [];
      return { actions: evs.filter((e) => e.action !== 'note').length,
               notes: evs.filter((e) => e.action === 'note').length };
    };

    /* "2h", "3d", "just now" — compact enough for a table cell. */
    const shortAgo = (iso) => {
      const ms = Date.now() - new Date(iso);
      if (isNaN(ms)) return '';
      const m = Math.floor(ms / 60000);
      if (m < 1) return 'just now';
      if (m < 60) return m + 'm';
      const h = Math.floor(m / 60);
      if (h < 24) return h + 'h';
      return Math.floor(h / 24) + 'd';
    };

    const counts = () => {
      const mine = LEADS.filter(inInbox);
      const c = { all: mine.length, quiet: 0, unread: 0 };
      for (const k of ORDER) c[k] = 0;
      for (const l of mine) {
        if (c[l.status] !== undefined) c[l.status]++;
        if (isQuiet(l)) c.quiet++;
        if (!l.first_viewed_at) c.unread++;
      }
      return c;
    };

    const visible = () => {
      const q = query.toLowerCase();
      return LEADS.filter((l) => {
        if (!inInbox(l)) return false;
        if (filter === 'quiet') { if (!isQuiet(l)) return false; }
        else if (filter === 'unread') { if (l.first_viewed_at) return false; }
        else if (filter !== 'all' && l.status !== filter) return false;
        if (!q) return true;
        return [l.name, l.email, l.phone, l.address, l.service_interest, bodyOf(l)]
          .some((f) => String(f || '').toLowerCase().includes(q));
      });
    };

    /* ── header nav (lives outside #app so it survives every re-render) ── */
    function paintNav() {
      const unreadLeads = unreadIn('lead');
      const unreadMsgs = unreadIn('message');
      const item = (key, label, d, badgeCount) => {
        const on = inbox === key;
        return `<button data-inbox="${key}" aria-pressed="${on}"
          class="inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 font-medium transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-forest ${
            on ? 'bg-forest text-cream' : 'text-[#5b6660] hover:bg-[#f1efe7] hover:text-forest'}">
          ${icon(d, 'h-4 w-4')}${label}${badgeCount ? `<span class="ml-0.5 inline-flex min-w-[1.25rem] justify-center rounded-full px-1.5 py-0.5 text-[11px] font-semibold tabular-nums ${
            on ? 'bg-cream/25 text-cream' : 'bg-brass text-forest'}">${badgeCount}</span>` : ''}</button>`;
      };
      $('#nav').innerHTML =
        item('lead', 'Leads', ICONS.inbox, unreadLeads) +
        item('message', 'Messages', ICONS.mail, unreadMsgs) +
        `<a href="/boroto/" class="rounded-md px-3 py-1.5 text-[#5b6660] transition-colors hover:bg-[#f1efe7] hover:text-forest">SEO dashboard</a>`;

      $('#nav').querySelectorAll('button[data-inbox]').forEach((b) =>
        b.addEventListener('click', () => {
          if (inbox === b.dataset.inbox) return;
          inbox = b.dataset.inbox;
          localStorage.setItem('boroto_inbox', inbox);
          filter = 'all'; query = '';
          location.hash = '';
          paintNav(); route();
        }));

      // Anything unread is worth showing in the tab title too, so a background
      // tab still tells him something is waiting.
      const waiting = unreadLeads + unreadMsgs;
      document.title = waiting ? `(${waiting}) Lead Desk` : 'Lead Desk';
    }

    /* ── list ── */
    function renderList() {
      const c = counts();
      const messages = inbox === 'message';
      const tab = (key, label, n, tone) => `
        <button data-f="${key}" aria-pressed="${filter === key}"
          class="flex items-baseline gap-2 rounded-lg border px-3.5 py-2 text-sm transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-forest ${
            filter === key ? 'border-forest bg-forest text-cream' : 'border-[#e2e0d6] bg-white text-[#3c4742] hover:border-[#c9c6b6]'}">
          <span class="font-medium">${label}</span>
          <span class="tabular-nums ${filter === key ? 'text-cream/70' : tone}">${n}</span>
        </button>`;

      const tabs = messages
        ? tab('all', 'All', c.all, 'text-[#5b6660]') + tab('unread', 'Unread', c.unread, c.unread ? 'text-[#92400e]' : 'text-[#5b6660]')
        : tab('all', 'All', c.all, 'text-[#5b6660]')
          + tab('new', 'New', c.new, 'text-[#1d4ed8]')
          + tab('proposal_sent', 'Proposal sent', c.proposal_sent, 'text-[#92400e]')
          + tab('quiet', 'Gone quiet', c.quiet, c.quiet ? 'text-[#b91c1c]' : 'text-[#5b6660]')
          + tab('won', 'Won', c.won, 'text-[#15803d]')
          + tab('lost', 'Lost', c.lost, 'text-[#5b6660]');

      const rows = visible();
      const head = messages
        ? ['Ref', 'Received (EST)', 'From', 'Message', 'Status']
        : ['Ref', 'Received (EST)', 'Name', 'Service', 'Location', 'Status'];

      const statusCell = (l) => {
        const e = latest(l);
        const c = countsOf(l);
        const a = e ? (ACTIVITY[e.action] || { icon: '•', verb: e.action }) : null;
        return `<td class="px-4 py-3">
          <div class="flex flex-col gap-1">
            <div>${badge(l.status)}${isQuiet(l) ? ` <span class="ml-1 whitespace-nowrap text-xs font-medium text-[#b91c1c]">· quiet ${daysSince(l.proposal_sent_at)}d</span>` : ''}</div>
            ${e ? `<div class="flex items-center gap-1.5 text-xs text-[#5b6660]">
                     <span aria-hidden="true">${a.icon}</span>
                     <span class="truncate"><span class="font-medium text-[#3c4742]">${esc(e.actor)}</span> ${esc(a.verb)}</span>
                     <span class="whitespace-nowrap text-[#9aa39e]">${esc(shortAgo(e.created_at))}</span>
                   </div>`
                : '<div class="text-xs text-[#9aa39e]">No activity yet</div>'}
            ${(c.actions || c.notes) ? `<div class="flex gap-1.5 text-[11px] text-[#5b6660]">
                 ${c.actions ? `<span class="rounded bg-[#f1efe7] px-1.5 py-0.5" title="${c.actions} action${c.actions === 1 ? '' : 's'} taken">${c.actions} action${c.actions === 1 ? '' : 's'}</span>` : ''}
                 ${c.notes ? `<span class="rounded bg-[#fdf3e3] px-1.5 py-0.5 text-[#92400e]" title="${c.notes} note${c.notes === 1 ? '' : 's'}">${c.notes} note${c.notes === 1 ? '' : 's'}</span>` : ''}
               </div>` : ''}
          </div>
        </td>`;
      };

      const cells = (l) => {
        const unread = !l.first_viewed_at;
        const refCell = `<td class="whitespace-nowrap px-4 py-3 font-mono text-xs text-[#5b6660]">${esc(ref(l))}${
          isManual(l) ? `<span class="ml-1.5 not-italic" title="Added by hand">✍️</span>` : ''}</td>`;
        const when = `
          <td class="whitespace-nowrap px-4 py-3 text-[#3c4742]">
            <span class="inline-flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full ${unread ? 'bg-brass' : 'bg-transparent'}"></span>
              <span class="${unread ? 'font-semibold text-forest' : ''}">${esc(shortStamp(l.received_at))}</span>
              <span class="text-xs text-[#9aa39e]">${esc(ago(l.received_at))}</span>
            </span>
          </td>`;
        if (messages) {
          const b = bodyOf(l);
          return refCell + when + `
            <td class="px-4 py-3 ${unread ? 'font-semibold' : 'font-medium'} text-forest">
              ${esc(l.name || '—')}
              ${l.email ? `<span class="block text-xs font-normal text-[#5b6660]">${esc(l.email)}</span>` : ''}
            </td>
            <td class="px-4 py-3 text-[#3c4742]">${esc(b ? (b.length > 80 ? b.slice(0, 80) + '…' : b) : '—')}</td>`
            + statusCell(l);
        }
        return refCell + when + `
          <td class="px-4 py-3 font-medium text-forest">${esc(l.name || '—')}</td>
          <td class="px-4 py-3 text-[#3c4742]">${esc(l.service_interest || '—')}</td>
          <td class="px-4 py-3 text-[#5b6660]">${esc((l.address || '—').slice(0, 34))}</td>`
          + statusCell(l);
      };

      $('#app').innerHTML = `
        <div class="flex flex-wrap items-center gap-2">
          ${tabs}
          <div class="ml-auto">
            <label for="q" class="sr-only">Search ${messages ? 'messages' : 'leads'}</label>
            <input id="q" type="search" value="${esc(query)}" placeholder="${messages ? 'Search sender, email, message…' : 'Search name, email, phone, address…'}"
              class="w-72 rounded-lg border border-[#e2e0d6] bg-white px-3.5 py-2 text-sm outline-none placeholder:text-[#9aa39e] focus:border-brass focus:ring-2 focus:ring-brass/30" />
          </div>
        </div>

        ${rows.length ? `
        <div class="mt-4 overflow-x-auto rounded-xl border border-[#e2e0d6] bg-white">
          <table class="w-full border-collapse text-sm">
            <thead>
              <tr class="border-b border-[#e2e0d6] text-left text-xs font-semibold uppercase tracking-wide text-[#5b6660]">
                ${head.map((h) => `<th class="px-4 py-2.5 font-semibold">${h}</th>`).join('')}
              </tr>
            </thead>
            <tbody>
              ${rows.map((l) => `
                <tr tabindex="0" data-id="${esc(l.id)}"
                  class="cursor-pointer border-b border-[#eeece3] last:border-0 transition-colors hover:bg-[#faf9f5] focus:bg-[#faf9f5] focus:outline-none">
                  ${cells(l)}
                </tr>`).join('')}
            </tbody>
          </table>
        </div>` : `
        <div class="mt-4 rounded-xl border border-dashed border-[#d8d5c8] bg-white py-16 text-center">
          <p class="font-display text-lg text-forest">${c.all ? 'Nothing matches' : (messages ? 'No messages yet' : 'No leads yet')}</p>
          <p class="mt-1 text-sm text-[#5b6660]">${c.all ? 'Try a different filter or search.'
            : (messages ? 'Anything sent through the contact page lands here.' : 'The next enquiry from either site lands here automatically.')}</p>
        </div>`}`;

      $('#app').querySelectorAll('button[data-f]').forEach((b) =>
        b.addEventListener('click', () => { filter = b.dataset.f; renderList(); }));

      const qi = $('#q');
      if (qi) {
        qi.addEventListener('input', () => {
          query = qi.value;
          const pos = qi.selectionStart;
          renderList();
          const n = $('#q'); n.focus(); n.setSelectionRange(pos, pos);
        });
      }
      $('#app').querySelectorAll('tr[data-id]').forEach((tr) => {
        const open = () => { location.hash = tr.dataset.id; };
        tr.addEventListener('click', open);
        tr.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } });
      });
    }

    /* ── detail ── */
    const panel = (title, rows) => {
      const body = rows.filter(([, v]) => String(v ?? '').trim()).map(([k, v]) => `
        <div class="grid grid-cols-[minmax(0,11rem)_1fr] gap-3 border-b border-[#f0eee6] py-2 last:border-0">
          <dt class="text-xs uppercase tracking-wide text-[#5b6660]">${esc(k)}</dt>
          <dd class="break-words text-sm text-[#1a2420]">${v}</dd>
        </div>`).join('');
      return body ? `<section class="rounded-xl border border-[#e2e0d6] bg-white p-5">
        <h3 class="font-display text-base text-forest">${esc(title)}</h3>
        <dl class="mt-2">${body}</dl></section>` : '';
    };

    function renderDetail(id) {
      const L = LEADS.find((x) => x.id === id);
      if (!L) { location.hash = ''; return; }
      // Deep link from a Telegram alert may point at the other inbox.
      if (!inInbox(L)) { inbox = isMsg(L) ? 'message' : 'lead'; localStorage.setItem('boroto_inbox', inbox); paintNav(); }

      const lead = L.raw_lead || {}, meta = L.raw_meta || {};
      const message = bodyOf(L);
      const messages = isMsg(L);

      const link = (k, v) => {
        const s = String(v);
        if (/email/i.test(k) && s.includes('@')) return `<a class="text-[#1d4ed8] underline-offset-2 hover:underline" href="mailto:${esc(s)}">${esc(s)}</a>`;
        if (/phone/i.test(k)) return `<a class="text-[#1d4ed8] underline-offset-2 hover:underline" href="tel:${esc(s.replace(/[^0-9+]/g,''))}">${esc(s)}</a>`;
        if (/^https?:\/\//.test(s)) return `<a class="break-all text-[#1d4ed8] underline-offset-2 hover:underline" target="_blank" rel="noopener" href="${esc(s)}">${esc(s)}</a>`;
        return esc(s);
      };
      const contactRe = /name|email|phone/i, srcRe = /page|referrer|utm|source/i;
      const bodyRe = /message|comment|how can we help/i;
      const pick = (o, f) => Object.entries(o).filter(([k]) => f(k)).map(([k, v]) => [k, link(k, v)]);

      $('#app').innerHTML = `
        <button id="back" class="mb-4 inline-flex items-center gap-1.5 text-sm text-[#5b6660] transition-colors hover:text-forest">
          ${icon(ICONS.back, 'h-4 w-4')} ${messages ? 'All messages' : 'All leads'}
        </button>

        <div class="rounded-xl border border-[#e2e0d6] bg-white p-6">
          <div class="flex flex-wrap items-start justify-between gap-5">
            <div class="min-w-0">
              <div class="flex items-center gap-2.5">
                <span class="rounded bg-[#f1efe7] px-2 py-0.5 font-mono text-xs font-medium text-[#5b6660]">${esc(ref(L))}</span>
                <h1 class="font-display text-2xl text-forest">${esc(L.name || (messages ? 'Unnamed sender' : 'Unnamed lead'))}</h1>
              </div>
              ${L.service_interest ? `<p class="mt-1 text-sm font-medium text-[#92400e]">${esc(L.service_interest)}</p>` : ''}
              <p class="mt-2 flex flex-wrap items-center gap-x-1.5 gap-y-1 text-sm text-[#5b6660]">
                <span>${esc(L.brand)} · ${esc(stamp(L.received_at))}</span>
                ${isManual(L) ? `<span class="inline-flex items-center gap-1 rounded-full bg-[#f1efe7] px-2 py-0.5 text-xs font-medium text-[#5b6660]"
                   title="Keyed in from the dashboard rather than captured by a form">✍️ Added by hand${L.page_url ? ` · ${esc(L.page_url)}` : ''}</span>` : ''}
              </p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <button id="copyAll" class="rounded-md border border-[#d8d5c8] px-3.5 py-2 text-sm text-forest transition-colors hover:border-brass hover:bg-[#fdfbf5]">Copy everything</button>
              ${!messages && L.address ? `<a target="_blank" rel="noopener" href="${esc(airdnaUrl(L.address))}"
                 class="inline-flex items-center gap-1.5 rounded-md border border-[#d8d5c8] px-3.5 py-2 text-sm text-forest transition-colors hover:border-brass hover:bg-[#fdfbf5] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-forest">
                 AirDNA${icon(ICONS.external, 'h-3.5 w-3.5 text-[#5b6660]')}<span class="sr-only">(opens in a new tab)</span></a>` : ''}
              <button id="move" class="inline-flex items-center gap-1.5 rounded-md border border-[#d8d5c8] px-3.5 py-2 text-sm text-forest transition-colors hover:border-brass hover:bg-[#fdfbf5]">
                ${icon(messages ? ICONS.inbox : ICONS.mail, 'h-4 w-4')}${messages ? 'Move to Leads' : 'Move to Messages'}</button>
              <button id="del" class="rounded-md border border-[#e6cbc8] px-3.5 py-2 text-sm text-[#a3231b] transition-colors hover:bg-[#fdeceb]">Delete</button>
            </div>
          </div>

          ${messages ? '' : `
          <div class="mt-5 border-t border-[#eeece3] pt-4">
            <div class="flex items-baseline justify-between gap-3">
              <span class="text-xs font-semibold uppercase tracking-wide text-[#5b6660]">Where it stands</span>
              <span id="savedFlag" class="text-xs font-medium text-[#15803d] opacity-0 transition-opacity">Saved</span>
            </div>

            <!-- A pipeline, shown as one segmented control rather than four
                 loose pills: the stages read left to right in the order they
                 actually happen, and the current one is unmistakable. State is
                 never colour alone — the selected stage also carries a tick and
                 aria-pressed. Targets are 44px tall for thumbs. -->
            <div role="group" aria-label="Lead status" class="mt-2 grid grid-cols-2 overflow-hidden rounded-xl border border-[#d8d5c8] sm:grid-cols-4">
              ${ORDER.map((k, i) => {
                const st = STATUS[k], on = L.status === k;
                return `<button data-s="${k}" aria-pressed="${on}"
                  class="flex min-h-[44px] items-center justify-center gap-2 border-[#e2e0d6] px-3 py-2.5 text-sm font-medium transition-colors focus-visible:z-10 focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-forest ${i > 0 ? 'border-l' : ''} ${i < 2 ? 'border-b sm:border-b-0' : ''} ${on ? '' : 'bg-white text-[#5b6660] hover:bg-[#faf9f5]'}"
                  style="${on ? `color:${st.fg};background:${st.bg}` : ''}">
                  ${icon(st.icon, 'h-4 w-4')}<span>${st.label}</span>
                  ${on ? icon('m5 12 5 5L20 7', 'h-3.5 w-3.5 opacity-70') : ''}
                </button>`;
              }).join('')}
            </div>

            <!-- Logging a touch is a different kind of act from moving the
                 pipeline, so it gets its own row instead of being mixed in.
                 Until now this was only possible from Telegram. -->
            <div class="mt-3 flex flex-wrap items-center gap-2">
              <span class="mr-1 text-xs font-semibold uppercase tracking-wide text-[#5b6660]">Log</span>
              ${[['called', '📞', 'Called'], ['texted', '💬', 'Texted'], ['emailed', '✉️', 'Emailed'], ['note', '📝', 'Add note']]
                .map(([a, ic, label]) => `<button data-log="${a}"
                  class="inline-flex min-h-[36px] items-center gap-1.5 rounded-lg border border-[#e2e0d6] bg-white px-3 py-1.5 text-sm text-[#3c4742] transition-colors hover:border-brass hover:bg-[#fdfbf5] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-forest">
                  <span aria-hidden="true">${ic}</span>${label}</button>`).join('')}
            </div>
          </div>`}

          <!-- The at-a-glance answer to "what's happened here?", so you don't
               have to scroll to the timeline to find out. -->
          <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 border-t border-[#eeece3] pt-3 text-sm">
            ${(() => {
              const e = latest(L), c = countsOf(L);
              if (!e) return '<span class="text-[#9aa39e]">No activity yet — nobody has touched this.</span>';
              const a = ACTIVITY[e.action] || { icon: '•', verb: e.action };
              return `<span class="text-[#3c4742]"><span aria-hidden="true">${a.icon}</span>
                        Last: <span class="font-medium text-forest">${esc(e.actor)}</span> ${esc(a.verb)}
                        <span class="text-[#9aa39e]">${esc(shortAgo(e.created_at))} ago</span></span>
                      <span class="text-[#9aa39e]">·</span>
                      <span class="text-[#5b6660]">${c.actions} action${c.actions === 1 ? '' : 's'}${c.notes ? `, ${c.notes} note${c.notes === 1 ? '' : 's'}` : ''}</span>
                      <a href="#activity-${esc(L.id)}" class="text-[#1d4ed8] underline-offset-2 hover:underline">See all</a>`;
            })()}
          </div>
        </div>

        ${message ? `
        <section class="mt-4 rounded-xl border border-[#e2e0d6] bg-white p-6">
          <h3 class="font-display text-base text-forest">What they wrote</h3>
          <p class="mt-3 whitespace-pre-wrap break-words text-[15px] leading-relaxed text-[#1a2420]">${esc(message)}</p>
        </section>` : ''}

        <div class="mt-4 grid gap-4 lg:grid-cols-2">
          ${panel('Contact', pick(lead, (k) => contactRe.test(k)))}
          ${panel(messages ? 'Anything else they sent' : 'The property',
                  pick(lead, (k) => !contactRe.test(k) && !bodyRe.test(k) && !/service interest/i.test(k)))}
          ${panel('Where they came from', pick(meta, (k) => srcRe.test(k)))}
          ${panel('Their session', pick(meta, (k) => !srcRe.test(k)))}
        </div>

        <section id="activity-${esc(L.id)}" class="mt-4 scroll-mt-20 rounded-xl border border-[#e2e0d6] bg-white p-5">
          <div class="flex items-baseline justify-between gap-3">
            <h3 class="font-display text-base text-forest">Activity</h3>
            <span class="text-xs text-[#9aa39e]">Everyone's actions, from Telegram and here</span>
          </div>
          ${(L.events || []).length ? `
          <ol class="mt-3 space-y-2.5">
            ${(L.events || []).slice().reverse().map((e) => {
              const a = ACTIVITY[e.action] || { icon: '•', verb: e.action };
              return `<li class="flex gap-3 text-sm">
                <span aria-hidden="true" class="mt-0.5 leading-none">${a.icon}</span>
                <div class="min-w-0">
                  <span class="font-medium text-forest">${esc(e.actor)}</span>
                  <span class="text-[#3c4742]">${esc(a.verb)}</span>
                  <span class="ml-1 whitespace-nowrap text-xs text-[#9aa39e]">${esc(stamp(e.created_at))}</span>
                  ${e.source === 'telegram' ? '<span class="ml-1 rounded bg-[#eef4ff] px-1.5 py-0.5 text-[11px] font-medium text-[#1d4ed8]">Telegram</span>' : ''}
                  ${e.note ? `<p class="mt-0.5 whitespace-pre-wrap break-words text-[#3c4742]">${esc(e.note)}</p>` : ''}
                </div>
              </li>`;
            }).join('')}
          </ol>` : `
          <p class="mt-2 text-sm text-[#5b6660]">Nothing yet. Actions taken from the Telegram group appear here automatically.</p>`}
        </section>

        <div class="mt-4 grid gap-4 lg:grid-cols-2">
          <section class="rounded-xl border border-[#e2e0d6] bg-white p-5">
            <h3 class="font-display text-base text-forest">Timeline</h3>
            <dl class="mt-2">
              ${[['Came in', stamp(L.received_at)], ['You opened it', stamp(L.first_viewed_at)],
                 ['Proposal sent', messages ? '' : stamp(L.proposal_sent_at)], ['Sent to', messages ? '' : esc(L.proposal_sent_to || '')]]
                .filter(([, v]) => v).map(([k, v]) => `
                <div class="grid grid-cols-[minmax(0,11rem)_1fr] gap-3 border-b border-[#f0eee6] py-2 last:border-0">
                  <dt class="text-xs uppercase tracking-wide text-[#5b6660]">${esc(k)}</dt>
                  <dd class="text-sm">${v}</dd></div>`).join('')}
            </dl>
            ${messages ? '' : `
            <label for="sentTo" class="mt-4 block text-xs uppercase tracking-wide text-[#5b6660]">Proposal sent to</label>
            <input id="sentTo" value="${esc(L.proposal_sent_to || '')}" placeholder="dana@example.com"
              class="mt-1.5 w-full rounded-lg border border-[#e2e0d6] px-3 py-2 text-sm outline-none focus:border-brass focus:ring-2 focus:ring-brass/30" />`}
          </section>

          <section class="rounded-xl border border-[#e2e0d6] bg-white p-5">
            <h3 class="font-display text-base text-forest">Notes</h3>
            <textarea id="notes" rows="10" placeholder="Anything worth remembering…"
              class="mt-2 w-full rounded-lg border border-[#e2e0d6] px-3 py-2 text-sm outline-none focus:border-brass focus:ring-2 focus:ring-brass/30">${esc(L.notes || '')}</textarea>
          </section>
        </div>`;

      $('#back').addEventListener('click', () => { location.hash = ''; });

      const flash = () => { const f = $('#savedFlag'); if (f) { f.style.opacity = '1'; setTimeout(() => { f.style.opacity = '0'; }, 1200); } };
      const sync = (body) => fetch(API, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).then(flash).catch(() => {});

      // Optimistic: repaint immediately, persist in the background.
      $('#app').querySelectorAll('button[data-s]').forEach((b) =>
        b.addEventListener('click', () => {
          const next = b.dataset.s;
          if (next === L.status) return;              // already there — do nothing
          L.status = next;
          if (next === 'proposal_sent' && !L.proposal_sent_at) L.proposal_sent_at = new Date().toISOString();
          // Mirror what the server will record, so the trail and summary are
          // right immediately rather than after the next refresh.
          const EV = { proposal_sent: 'proposal', won: 'won', lost: 'lost' }[next];
          if (EV) L.events = (L.events || []).concat([{
            action: EV, actor: 'Brandon', source: 'dashboard', created_at: new Date().toISOString(),
          }]);
          renderDetail(id);
          sync({ id, status: next, proposal_sent_to: L.proposal_sent_to || '' });
        }));

      /* Logging an action from the dashboard writes into the same history the
         Telegram buttons write to, and rewrites the group's card. Optimistic:
         the trail repaints immediately, the write follows. */
      $('#app').querySelectorAll('button[data-log]').forEach((b) =>
        b.addEventListener('click', async () => {
          const act = b.dataset.log;
          let note = '';
          if (act === 'note') {
            note = (prompt('Note for this lead?') || '').trim();
            if (!note) return;
          }
          L.events = (L.events || []).concat([{
            action: act, actor: 'Brandon', source: 'dashboard',
            note, created_at: new Date().toISOString(),
          }]);
          if (act === 'proposal') L.status = 'proposal_sent';
          renderDetail(id);
          fetch(API, { method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'log', id, event: act, note }) })
            .then(flash).catch(() => {});
        }));

      $('#move').addEventListener('click', () => {
        const to = messages ? 'lead' : 'message';
        L.kind = to;
        inbox = to;
        localStorage.setItem('boroto_inbox', inbox);
        paintNav();
        renderDetail(id);
        fetch(API, { method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'move', id, kind: to }) }).catch(() => {});
      });

      $('#copyAll').addEventListener('click', async () => {
        const txt = [
          `${messages ? 'MESSAGE' : 'LEAD'} — ${L.name || 'Unnamed'} (${L.brand})`,
          `Received: ${stamp(L.received_at)}`,
          L.service_interest ? `Service: ${L.service_interest}` : '',
          '', '--- What they submitted ---',
          ...Object.entries(lead).map(([k, v]) => `${k}: ${v}`),
          '', '--- Where they came from ---',
          ...Object.entries(meta).map(([k, v]) => `${k}: ${v}`),
          L.notes ? `\n--- My notes ---\n${L.notes}` : '',
        ].filter(Boolean).join('\n');
        await navigator.clipboard.writeText(txt);
        const b = $('#copyAll'), old = b.textContent;
        b.textContent = 'Copied'; setTimeout(() => { b.textContent = old; }, 1400);
      });

      $('#del').addEventListener('click', async () => {
        if (!confirm(`Delete this ${messages ? 'message' : 'lead'} from ${L.name || 'unknown'}? This cannot be undone.`)) return;
        LEADS = LEADS.filter((x) => x.id !== id);
        pendingSave = null;
        location.hash = '';
        paintNav();
        fetch(API, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'delete', id }) }).catch(() => {});
      });

      let t;
      const commit = () => {
        clearTimeout(t);
        const sentEl = $('#sentTo');
        L.notes = $('#notes').value;
        if (sentEl) L.proposal_sent_to = sentEl.value.trim();
        pendingSave = null;
        return sync({ id, notes: L.notes, proposal_sent_to: L.proposal_sent_to || '' });
      };
      const debounced = () => { clearTimeout(t); pendingSave = commit; t = setTimeout(commit, 600); };
      $('#notes').addEventListener('input', debounced);
      if ($('#sentTo')) $('#sentTo').addEventListener('input', debounced);

      if (!L.first_viewed_at) {
        L.first_viewed_at = new Date().toISOString();
        paintNav();                       // clears the unread badge immediately
        sync({ id, viewed: true });
      }
    }

    /* ── add lead ──────────────────────────────────────────────────────────
     * A real dialog with real fields, replacing five chained prompt() boxes
     * that had no labels, no validation, and never touched Telegram. */
    (() => {
      const dlg = $('#addDialog'), form = $('#addForm'), errEl = $('#addError'), submitBtn = $('#addSubmit');
      const nameEl = $('#af-name'), dateEl = $('#af-date'), timeEl = $('#af-time'), preview = $('#af-when-preview');

      /* Convert a wall-clock Eastern date+time into a correct UTC instant,
         accounting for EDT/EST — the offset a fixed "-04:00" string would get
         wrong for roughly half the year. Works by rendering a first guess back
         through the America/New_York timezone and correcting by the drift. */
      function easternToUTC(dateStr, timeStr) {
        const [y, mo, d] = dateStr.split('-').map(Number);
        const [h, mi] = timeStr.split(':').map(Number);
        if (!y || !mo || !d || (h !== 0 && !h) || mi == null || Number.isNaN(h) || Number.isNaN(mi)) return null;
        let guess = Date.UTC(y, mo - 1, d, h, mi);
        const parts = new Intl.DateTimeFormat('en-US', {
          timeZone: 'America/New_York', hourCycle: 'h23',
          year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit',
        }).formatToParts(new Date(guess));
        const g = (t) => Number(parts.find((p) => p.type === t)?.value);
        const shownAsUTC = Date.UTC(g('year'), g('month') - 1, g('day'), g('hour'), g('minute'));
        return new Date(guess + (guess - shownAsUTC)).toISOString();
      }

      function nowInEastern() {
        const parts = new Intl.DateTimeFormat('en-US', {
          timeZone: 'America/New_York', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23',
        }).formatToParts(new Date());
        const g = (t) => parts.find((p) => p.type === t)?.value;
        return { date: `${g('year')}-${g('month')}-${g('day')}`, time: `${g('hour')}:${g('minute')}` };
      }

      function updatePreview() {
        const iso = easternToUTC(dateEl.value, timeEl.value);
        preview.textContent = iso ? `→ ${stamp(iso)}` : '';
      }
      dateEl.addEventListener('input', updatePreview);
      timeEl.addEventListener('input', updatePreview);

      function openDialog() {
        form.reset();
        errEl.classList.add('hidden');
        const n = nowInEastern();
        dateEl.value = n.date; timeEl.value = n.time;
        $('#af-kind').value = inbox;   // default to whichever inbox is open
        updatePreview();
        dlg.showModal();
        nameEl.focus();
      }
      $('#addBtn').addEventListener('click', openDialog);
      $('#addCancel').addEventListener('click', () => dlg.close());
      $('#addClose').addEventListener('click', () => dlg.close());
      // Click on the backdrop closes it — clicking the form itself must not.
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = nameEl.value.trim();
        if (!name) { errEl.textContent = 'Name is required.'; errEl.classList.remove('hidden'); nameEl.focus(); return; }

        const receivedAt = easternToUTC(dateEl.value, timeEl.value);
        if (!receivedAt) { errEl.textContent = 'Enter a valid date and time.'; errEl.classList.remove('hidden'); return; }

        errEl.classList.add('hidden');
        submitBtn.disabled = true; submitBtn.textContent = 'Adding…';

        const payload = {
          action: 'create',
          name,
          email: $('#af-email').value.trim(),
          phone: $('#af-phone').value.trim(),
          address: $('#af-address').value.trim(),
          service_interest: $('#af-service').value.trim(),
          message: $('#af-message').value.trim(),
          notes: $('#af-notes').value.trim(),
          source: $('#af-source').value.trim(),
          brand: $('#af-brand').value,
          kind: $('#af-kind').value,
          received_at: receivedAt,
          send_telegram: $('#af-telegram').checked,
        };

        try {
          const r = await fetch(API, { method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload) }).then((x) => x.json());
          if (!r.ok) throw new Error(r.error || 'Could not add this lead.');
          dlg.close();
          await load();
          paintNav();
          location.hash = r.id;
          if (payload.send_telegram && !r.telegram) {
            // Saved fine; only the Telegram post itself didn't land. Surface it
            // rather than let it pass silently — the lead is safe either way.
            setTimeout(() => alert('Saved. Telegram is not configured or did not accept the message, so no card was posted for this one.'), 50);
          }
        } catch (err) {
          errEl.textContent = String(err.message || err);
          errEl.classList.remove('hidden');
        } finally {
          submitBtn.disabled = false; submitBtn.textContent = 'Add lead';
        }
      });
    })();

    /* ── refresh ────────────────────────────────────────────────────────────
     * The one deliberate network path in the UI. Anything typed but not yet
     * saved is flushed first, so a refresh can never discard a note. */
    let flashLabel = '';   // transient "+2 new" confirmation

    function paintRefresh() {
      const b = $('#refreshBtn'), i = $('#refreshIcon'), l = $('#refreshLabel'), s = $('#synced');
      b.disabled = busy;
      i.style.animation = busy ? 'boroto-spin .8s linear infinite' : '';
      l.textContent = busy ? 'Checking…' : (flashLabel || 'Refresh');
      if (lastSync) { s.textContent = `Updated ${clockStamp(lastSync)}`; s.classList.remove('hidden'); }
    }

    async function refresh() {
      if (busy) return;
      busy = true; flashLabel = ''; paintRefresh();
      try {
        // Never let a refresh discard something half-typed.
        if (pendingSave) { try { await pendingSave(); } catch { /* keep going */ } }
        const before = LEADS.length;
        if (await load()) {
          lastSync = Date.now();
          const gained = LEADS.length - before;
          if (gained > 0) {
            flashLabel = `+${gained} new`;
            setTimeout(() => { flashLabel = ''; if (!busy) paintRefresh(); }, 2500);
          }
          paintNav();
          route();
        }
      } finally {
        busy = false; paintRefresh();
      }
    }
    $('#refreshBtn').addEventListener('click', refresh);

    // Coming back to the tab after a while is the other moment fresh data is
    // wanted. Only on the list — never mid-edit on a record.
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState !== 'visible') return;
      if (location.hash) return;
      if (Date.now() - lastSync < 60000) return;
      refresh();
    });

    /* Quietly pick up new leads while the desk is left open. Without this a
       lead can sit in the database, alerted in Telegram, and still look absent
       here — which reads exactly like it was lost. Skipped while a record is
       open so it can never interrupt typing, and skipped when the tab is
       hidden so a backgrounded desk isn't polling for nothing. */
    const AUTO_REFRESH_MS = 45000;
    setInterval(() => {
      if (document.visibilityState !== 'visible') return;
      if (location.hash) return;          // a record is open — leave it alone
      if (busy) return;
      refresh();
    }, AUTO_REFRESH_MS);

    function route() {
      const id = location.hash.replace(/^#/, '');
      if (id) renderDetail(id); else renderList();
    }
    window.addEventListener('hashchange', route);

    async function load() {
      const res = await fetch(API + '?action=all', { headers: { Accept: 'application/json' } })
        .catch(() => null);
      // Session expired → the login page, not a dead panel or a browser prompt.
      if (res && res.status === 401) { location.href = '/boroto/login?next=/boroto/leads/'; return false; }
      const r = res ? await res.json().catch(() => ({ error: 'Bad response from the server' }))
                    : { error: 'Could not reach the server' };
      if (r.error) { $('#app').innerHTML = `<p class="py-16 text-center text-sm text-[#a3231b]">${esc(r.error)}</p>`; return false; }
      LEADS = r.leads || [];
      return true;
    }

    paintNav();
    load().then((ok) => { if (ok) { lastSync = Date.now(); paintRefresh(); paintNav(); } route(); });
  })();
  </script>

  <style is:inline>
    @keyframes boroto-spin { to { transform: rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) { #refreshIcon { animation: none !important; } }

    /* A modal <dialog> is centred by the browser's own `margin: auto`, but
       Tailwind's preflight sets `margin: 0` on `*`, which silently wins and
       pins the dialog to the top-left corner. This one line is the entire fix.

       Do NOT make this a flex container and give #addForm `flex-1`. That was
       tried on 2026-08-25 and collapsed the whole dialog to a 2px line in
       Safari: `flex-1` is `flex-basis: 0%`, and a flex item with a 0 basis and
       `min-height: 0` contributes nothing to the intrinsic height of a parent
       that has no definite height of its own, so Safari resolved it to zero.
       Chromium guessed differently, which is exactly why it passed testing and
       still broke in production. The form's own `max-h-[88vh]` is a DEFINITE,
       viewport-relative height that needs no parent to resolve against — it
       works in every engine, and it is what should stay. */
    #addDialog { margin: auto; }
  </style>
</BaseLayout>
