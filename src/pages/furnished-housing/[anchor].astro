---
/* Furnished / mid-term housing near a named institution.
 *
 * A deliberately different page from /near/{landmark}/. Those target short-term
 * rental management near stadiums and attractions. This targets a furnished
 * stay of thirty days or more near a hospital, studio or campus — a different
 * guest, a different lease, a different search, and the cluster that actually
 * converts through AI assistants.
 *
 * The Sources block at the foot is not decoration. Of the four pages ChatGPT
 * currently sends converting traffic to, the only two carrying real dated
 * third-party citations are the two furnished-housing service pages. Every
 * figure on this page traces to a source rendered on the page.
 *
 * ROUTING: this is a static route segment, so it takes precedence over the
 * dynamic /[city]/[neighborhood]/ catch-all. Do not move these under a city
 * path — see the routing trap documented in CLAUDE.md.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import FAQ from '@/components/ui/FAQ.astro';
import CTABand from '@/components/ui/CTABand.astro';
import ServiceFormBand from '@/components/services/ServiceFormBand.astro';
import { site } from '@/config/site';
import { publishedAnchors, THIRTY_DAY_LINE } from '@/data/anchors';
import { breadcrumbSchema, faqPageSchema, serviceSchema, articleSchema } from '@/lib/schema';

export function getStaticPaths() {
  return publishedAnchors.map((a) => ({ params: { anchor: a.slug }, props: { a } }));
}

const { a } = Astro.props;

const heading = `Furnished & Mid-Term Housing Near ${a.shortName ?? a.name}`;
// Keep the institution name — it is the whole point of the page and the thing
// people search. Trim the descriptor before ever trimming the name.
const titleCandidates = [
  `Furnished Housing Near ${a.shortName ?? a.name}`,
  `Furnished Rentals Near ${a.shortName ?? a.name}`,
  `Housing Near ${a.shortName ?? a.name}`,
];
const seoTitle = titleCandidates.find((t) => t.length <= 60) ?? titleCandidates[2];
const seoDescription =
  `Furnished 30+ day rentals near ${a.shortName ?? a.name} in ${a.city}, GA — managed end to end for owners. Travel nurses, residents, corporate stays and relocating families.`;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Furnished housing', path: '/furnished-housing/' },
  { name: a.shortName ?? a.name, path: `/furnished-housing/${a.slug}/` },
];

const schemas = [
  breadcrumbSchema(breadcrumbs),
  serviceSchema({
    name: heading,
    description: seoDescription,
    serviceType: 'Mid-Term Rental Management',
    area: { name: `${a.city}, GA`, type: 'City', county: a.county },
  }),
  faqPageSchema(a.faqs),
  /* dateModified is derived from the newest source check on the page rather
     than hand-set, so it can never claim to be fresher than the facts it
     rests on. Re-check a source, move its `checked` date, and this follows. */
  articleSchema({
    title: heading,
    description: seoDescription,
    path: `/furnished-housing/${a.slug}/`,
    dateModified: a.sources.map((s) => s.checked).sort().at(-1),
    speakable: true,
  }),
];
---

<BaseLayout title={seoTitle} description={seoDescription} schemas={schemas}>
  <PageHero
    title={heading}
    subtitle={a.tagline}
    eyebrow={a.kind.toUpperCase()}
    breadcrumbs={breadcrumbs}
    cta={{ label: 'Get my free projection', href: '/rental-projection/' }}
  />

  <!-- ─── WHY THE DEMAND IS HERE ─── -->
  <Section variant="white">
    <Container size="narrow">
      <Eyebrow>Why this location works</Eyebrow>
      <h2 class="mt-3 font-display text-3xl text-forest sm:text-4xl">
        What creates furnished demand at {a.shortName ?? a.name}
      </h2>
      <div class="mt-6 space-y-5">
        {a.demand.map((p) => <p class="leading-relaxed text-ink/80">{p}</p>)}
      </div>

      <div class="mt-10 overflow-x-auto rounded-2xl border border-line bg-white">
        <table class="w-full text-left text-sm">
          <caption class="sr-only">Verified facts about {a.name}</caption>
          <tbody>
            {a.facts.map((f) => (
              <tr class="border-b border-[#f0eee6] last:border-0">
                <th scope="row" class="whitespace-nowrap px-5 py-3 align-top text-xs uppercase tracking-wide text-[#5b6660]">{f.label}</th>
                <td class="px-5 py-3 text-ink/85">{f.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Container>
  </Section>

  <!-- ─── WHO STAYS ─── -->
  <Section variant="cream">
    <Container size="narrow">
      <Eyebrow>Who actually stays</Eyebrow>
      <h2 class="mt-3 font-display text-3xl text-forest sm:text-4xl">
        The guest is not a tourist.
      </h2>
      <p class="mt-5 text-ink/75">
        A furnished let near {a.shortName ?? a.name} is booked by people who need
        somewhere to live for a defined stretch of time — long enough that a hotel
        stops making sense, short enough that a twelve-month lease is impossible.
      </p>
      <ul class="mt-7 grid gap-x-8 gap-y-3 sm:grid-cols-2">
        {a.audiences.map((who) => (
          <li class="flex items-start gap-2.5 text-[15px] text-ink/80">
            <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-brass"></span>
            {who}
          </li>
        ))}
      </ul>

      <div class="mt-9 rounded-2xl border-l-2 border-brass/60 bg-white/70 p-6 sm:p-8">
        <h3 class="font-display text-lg text-forest">The 30-day line</h3>
        <p class="mt-3 text-[15px] leading-relaxed text-ink/80">{THIRTY_DAY_LINE}</p>
      </div>
    </Container>
  </Section>

  <ServiceFormBand
    heading={`Thinking about a furnished let near ${a.shortName ?? a.name}?`}
    text="Send us the address and we'll come back with real numbers for it, from a person on our team, within one business day."
  />

  <!-- ─── HOW WE MANAGE IT ─── -->
  <Section variant="white">
    <Container size="narrow">
      <Eyebrow>How we manage it</Eyebrow>
      <h2 class="mt-3 font-display text-3xl text-forest sm:text-4xl">
        One team, whichever way the property is let
      </h2>
      <p class="mt-5 text-ink/75">
        Furnished mid-term is one strategy among several, and the right one depends
        on the property rather than on what suits us. If a nightly let or a
        twelve-month tenancy would earn you more, we will say so. These are the
        service lines that most often apply around {a.shortName ?? a.name}:
      </p>
      <div class="mt-7 flex flex-wrap gap-2.5">
        {a.services.map((s) => (
          <a
            href={s.href}
            class="rounded-full border border-line bg-white px-4 py-2 text-sm text-ink/80 transition-colors hover:border-brass hover:bg-[#fdfbf5] hover:text-forest focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-forest"
          >{s.name}</a>
        ))}
      </div>

      <h3 class="mt-11 font-display text-xl text-forest">Areas we manage nearby</h3>
      <div class="mt-4 flex flex-wrap gap-2.5">
        {a.nearby.map((n) => (
          <a
            href={n.href}
            class="rounded-full border border-line bg-white px-4 py-2 text-sm text-ink/80 transition-colors hover:border-brass hover:bg-[#fdfbf5] hover:text-forest focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-forest"
          >{n.name}</a>
        ))}
      </div>

      <p class="mt-8 text-[15px] text-ink/75">
        Want the whole property handled rather than one strategy?
        {' '}
        <a href={`/${a.city.toLowerCase().replace(/\s+/g, '-')}/`} class="font-medium text-forest underline decoration-brass/60 underline-offset-4 transition-colors hover:text-brass-600">{a.city} property management</a>
        {' '}covers short-term, long-term and everything between.
      </p>
    </Container>
  </Section>

  <!-- ─── FAQ ─── -->
  <Section variant="tint">
    <Container size="narrow">
      <Eyebrow>Questions owners ask</Eyebrow>
      <h2 class="mt-3 font-display text-3xl text-forest sm:text-4xl">
        Furnished housing near {a.shortName ?? a.name}
      </h2>
      <div class="mt-8"><FAQ items={a.faqs} /></div>
    </Container>
  </Section>

  <!-- ─── SOURCES ─── -->
  <!-- Rendered, not hidden. Every figure above traces to one of these, and this
       block is the difference between a page an assistant will cite and one it
       will paraphrase without attribution. Keep the access dates current. -->
  <Section variant="white">
    <Container size="narrow">
      <h2 class="font-display text-xl text-forest">Sources</h2>
      <p class="mt-2 text-sm text-ink/70">
        Every figure on this page comes from one of the following, checked on the date shown.
      </p>
      <ol class="mt-5 space-y-2.5 text-sm">
        {a.sources.map((s) => (
          <li class="text-ink/75">
            <a href={s.url} rel="nofollow noopener" target="_blank" class="text-forest underline decoration-brass/50 underline-offset-4 transition-colors hover:text-brass-600">{s.label}</a>
            <span class="text-[#9aa39e]"> — checked {s.checked}</span>
          </li>
        ))}
      </ol>
      <p class="mt-6 text-sm text-ink/70">
        Local rules change. We confirm the position for your specific address before
        a property is listed, and nothing here is legal or tax advice. Call us on
        {' '}<a href={site.contact.phoneHref} class="font-medium text-forest underline decoration-brass/60 underline-offset-4 hover:text-brass-600">{site.contact.phone}</a>.
      </p>
    </Container>
  </Section>

  <CTABand
    heading={`Own a property near ${a.shortName ?? a.name}?`}
    text="Get a free projection and we'll tell you honestly which letting strategy earns most."
  />
</BaseLayout>
