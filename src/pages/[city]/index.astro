---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Button from '@/components/ui/Button.astro';
import NeighborhoodCard from '@/components/ui/NeighborhoodCard.astro';
import FAQ from '@/components/ui/FAQ.astro';
import CTABand from '@/components/ui/CTABand.astro';
import Prose from '@/components/ui/Prose.astro';
import CheckList from '@/components/ui/CheckList.astro';
import ServiceFormBand from '@/components/services/ServiceFormBand.astro';
import { breadcrumbSchema, serviceSchema } from '@/lib/schema';
import { images, type ImageKey } from '@/data/images';
import { serviceLines } from '@/data/serviceLines';
import { site } from '@/config/site';
import { cityGeo } from '@/data/cityGeo';
import { assignCardStyles } from '@/lib/cardImage';
import { firstSentence } from '@/lib/text';
import { cityCountyMap, countyBySlug } from '@/data/counties';
import { landmarks } from '@/data/landmarks';
import { publishedAnchors } from '@/data/anchors';
import { buildExplore, exploreGridClass } from '@/lib/explore';

export async function getStaticPaths() {
  const c = await getCollection('cities');
  return c.filter((e) => e.data.published).map((e) => ({ params: { city: e.data.slug }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const isAtlanta = d.region === 'atlanta';

// Local geo (frontmatter first, then the cityGeo map) — powers schema + copy
const mapGeo = cityGeo[d.slug];
const lat = typeof d.lat === 'number' ? d.lat : mapGeo?.lat;
const lng = typeof d.lng === 'number' ? d.lng : mapGeo?.lng;
const county = d.county ?? mapGeo?.county;
const countyOf = (c: typeof entry) => c.data.county ?? cityGeo[c.data.slug]?.county;

const isVacation = d.region === 'georgia';

/* Every service line that actually has a live page for this city. Mirrors
   getStaticPaths() in services/[service]/[city].astro, so this can only ever
   list a page that was really built. */
const citySvcs = serviceLines.filter((s) => s.marketCities.includes(d.slug) && d.intro);
const hasLongTerm = citySvcs.some((s) =>
  ['long-term-rental-management', 'tenant-placement', 'hoa-management',
   'commercial-property-management', 'multi-family-property-management'].includes(s.slug));

/* TITLES — measured, not guessed. Search Console (28 days) shows
   "<city> property management" pulling 968 impressions across 188 queries
   against 462 for every "airbnb ..." query combined: 2.1x the demand. Every
   city page was nonetheless titled "Airbnb Management in <city>", mentioning
   "property management" once against "airbnb" 36 times, and ranking ~position
   75 for the bigger term. Leading with the phrase people actually type is
   also more accurate — these cities have real long-term, HOA and commercial
   service pages live, not just short-term. */
const heading = isVacation
  ? `Vacation Rental & Property Management in ${d.name}, ${d.state}`
  : `Property Management in ${d.name}, ${d.state}`;
const seoTitle = isVacation
  ? `${d.name} Vacation Rental & Property Management, GA`
  : `${d.name} Property Management, GA — Short & Long-Term`;
const countyLine = county ? ` We manage homes across ${d.name} and ${county} County.` : '';

// Neighborhoods (Atlanta only)
const allNeighborhoods = await getCollection('neighborhoods', (n) => n.data.published && n.data.citySlug === d.slug);
const neighborhoodMap = Object.fromEntries(allNeighborhoods.map((n) => [n.data.slug, n]));
const orderedNeighborhoods = d.neighborhoods.map((slug) => neighborhoodMap[slug]).filter(Boolean);
/* The explore grid is assembled AFTER `nearby` is computed (below), because
   nearby cities are the last resort that fills out a short row. */

// Nearby markets — same county first, then same region (internal linking)
const allCities = await getCollection('cities', (c) => c.data.published);
const regionLabel = d.region === 'georgia' ? 'Across Georgia' : 'Metro Atlanta';
const byName = (a: typeof entry, b: typeof entry) => a.data.name.localeCompare(b.data.name);
const sameCounty = (county ? allCities.filter((c) => c.data.slug !== d.slug && countyOf(c) === county) : []).sort(byName);
const sameRegion = allCities
  .filter((c) => c.data.slug !== d.slug && (isAtlanta ? c.data.region === 'metro' : c.data.region === d.region))
  .sort(byName);
const nearby = [...new Map([...sameCounty, ...sameRegion].map((c) => [c.data.slug, c])).values()].slice(0, 8);

/* EXPLORE GRID. Previously this rendered only the city's own neighborhood
   pages, so 85 of 100 city pages rendered nothing here and Marietta rendered
   two cards in a four-wide grid with two empty columns. It now falls through
   to the furnished-housing anchors and landmark pages that sit in this city —
   pages the city page linked to nowhere at all — and finally to nearby cities.
   See src/lib/explore.ts for the ordering and why the landmark mapping is
   inverted from the landmark's own `nearby` list rather than hand-written. */
const explore = buildExplore({
  citySlug: d.slug,
  neighborhoods: orderedNeighborhoods.map((n) => ({
    name: n.data.name,
    slug: n.data.slug,
    intro: n.data.intro,
  })),
  anchors: publishedAnchors,
  landmarks: landmarks.filter((l) => l.published),
  nearbyCities: nearby.map((c) => ({ name: c.data.name, slug: c.data.slug, intro: c.data.intro })),
});
/* `nearby` is capped at 8, which is ample padding for a four-wide grid. */
const exploreStyles = assignCardStyles(
  explore.map((e) => ({ slug: e.slug, region: e.kind === 'neighborhood' ? 'atlanta' : d.region })),
);
const exploreHrefs = new Set(explore.map((e) => e.href));
/* All neighborhoods, so the heading stays honest; anything else and the
   section is doing more than its old name claimed. */
const exploreIsAllNeighborhoods = explore.every((e) => e.kind === 'neighborhood');

// Parent county (if we have a county service page for this city).
const cityCountySlug = cityCountyMap[d.slug];
const cityCounty = cityCountySlug ? countyBySlug[cityCountySlug] : null;

const heroKey: ImageKey = d.heroImage && d.heroImage in images ? (d.heroImage as ImageKey) : 'atlantaSkyline';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Areas We Serve', path: '/areas-we-serve/' },
    { name: d.name, path: `/${d.slug}/` },
  ]),
  serviceSchema({
    name: heading,
    description: d.description,
    area: { name: `${d.name}, ${d.state}`, lat, lng, county },
  }),
];
---

<BaseLayout title={seoTitle} description={d.description} image={images[heroKey].src} schemas={schemas}>
  <PageHero
    title={heading}
    subtitle={d.intro}
    eyebrow={`${d.name} · Airbnb & Vrbo management`}
    imageKey={heroKey}
    breadcrumbs={[
      { name: 'Home', path: '/' },
      { name: 'Areas We Serve', path: '/areas-we-serve/' },
      { name: d.name, path: `/${d.slug}/` },
    ]}
    cta={{ label: 'Get my free rental projection', href: '/rental-projection/' }}
    secondaryCta={{ label: 'All areas we serve', href: '/areas-we-serve/' }}
    size="lg"
  />

  <!-- What we deliver -->
  <Section variant="cream">
    <Container>
      <div class="grid gap-12 lg:grid-cols-2 lg:items-start lg:gap-20">
        <div>
          <Eyebrow>What we deliver</Eyebrow>
          <h2 class="mt-3 font-display text-3xl text-forest sm:text-4xl">Full-service management in {d.name}</h2>
          <p class="mt-4 text-ink/80">
            ATLStay handles every part of your {d.name} short-term rental — listing creation and professional photography, dynamic pricing, 24/7 guest communication, cleaning, and turnovers. One transparent rate, {site.pricing.rateNote}.{countyLine}
          </p>
          <Button href="/services/" variant="secondary" class="mt-6">See all services &rarr;</Button>
        </div>
        {d.highlights.length > 0 && (
          <div class="rounded-2xl border border-line bg-white p-8">
            <h3 class="font-display text-lg text-forest">Why ATLStay in {d.name}</h3>
            <div class="mt-4"><CheckList items={d.highlights} /></div>
          </div>
        )}
      </div>
    </Container>
  </Section>

  <!-- Neighborhoods grid (Atlanta) -->
  {explore.length > 0 && (
    <Section variant="white">
      <Container size="wide">
        <div class="mb-10 text-center">
          <Eyebrow>{exploreIsAllNeighborhoods ? `${d.name} neighborhoods` : `Explore ${d.name}`}</Eyebrow>
          <h2 class="mt-3 font-display text-3xl text-forest sm:text-4xl">
            {exploreIsAllNeighborhoods
              ? `Neighborhoods we serve in ${d.name}`
              : `Where we manage in and around ${d.name}`}
          </h2>
          <p class="mx-auto mt-4 max-w-2xl text-ink/70">
            {exploreIsAllNeighborhoods
              ? `Each ${d.name} neighborhood has its own demand profile and guest mix. We manage properties across all of them.`
              : `Every area, landmark and institution around ${d.name} has its own demand profile and guest mix. These are the ones we manage into.`}
          </p>
        </div>
        <div class={exploreGridClass(explore.length)}>
          {explore.map((e, i) => (
            <NeighborhoodCard
              name={e.name}
              href={e.href}
              gradient={exploreStyles[i].gradient}
              icon={exploreStyles[i].icon}
              blurb={e.blurb ? firstSentence(e.blurb) : undefined}
            />
          ))}
        </div>
      </Container>
    </Section>
  )}

  <!-- Why local management matters -->
  <Section variant="forest">
    <Container>
      <div class="mx-auto max-w-3xl text-center">
        <Eyebrow class="text-brass">Local vs. national</Eyebrow>
        <h2 class="mt-3 font-display text-3xl text-cream sm:text-4xl">The {d.name} advantage: local knowledge at every level</h2>
        <p class="mt-5 text-cream/80">
          National STR platforms run algorithms, not relationships — pricing from national datasets, remote contractor turnovers, and call-center support with no feel for your market. ATLStay is different: we know {d.name}'s demand patterns, event calendar, and the local vendor relationships that make turnovers reliable and reviews five-star.
        </p>
        <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-3">
          {[
            { value: '24/7', label: 'Local guest support' },
            { value: site.pricing.rate, label: 'All-inclusive management rate' },
            { value: '5★', label: site.scale.ratingPhrase },
          ].map((stat) => (
            <div class="rounded-xl border border-cream/15 bg-cream/5 p-6">
              <div class="font-display text-2xl text-brass">{stat.value}</div>
              <div class="mt-1 text-sm text-cream/70">{stat.label}</div>
            </div>
          ))}
        </div>
        <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <Button href="/rental-projection/" size="lg">Get my free {d.name} projection</Button>
          <a href={site.contact.phoneHref} class="text-sm font-medium text-cream/80 transition-colors hover:text-brass">or call {site.contact.phone}</a>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Rich body -->
  <Section variant="white">
    <Container size="narrow"><Prose><Content /></Prose></Container>
  </Section>

  <ServiceFormBand
    variant="tint"
    heading={`What could your ${d.name} property earn?`}
    text="Send us the address and we'll come back with real numbers for it, from a person on our team, within one business day."
  />

  <!-- Regulations: Atlanta-specific vs general (never assert wrong local rules) -->
  <Section variant="cream">
    <Container>
      <div class="rounded-2xl border border-line bg-white px-8 py-10">
        {isAtlanta ? (
          <div class="grid gap-8 lg:grid-cols-2 lg:items-center">
            <div>
              <Eyebrow>Regulatory compliance</Eyebrow>
              <h2 class="mt-3 font-display text-2xl text-forest sm:text-3xl">{d.name} short-term rental regulations</h2>
              <p class="mt-4 text-ink/80">The City of Atlanta requires a Short-Term Rental License, and DeKalb County introduced its own program effective May 2026. Operating without the right permits can mean steep fines. We guide every client through compliance and stay current as rules change.</p>
            </div>
            <div class="space-y-4">
              <div class="rounded-lg border border-line p-4">
                <div class="text-sm font-medium text-forest">City of Atlanta STRL</div>
                <div class="mt-1 text-sm text-ink/70">~$150/year · primary-residence rules · via atl311.com</div>
              </div>
              <div class="rounded-lg border border-line p-4">
                <div class="text-sm font-medium text-forest">DeKalb County (eff. May 2026)</div>
                <div class="mt-1 text-sm text-ink/70">~$175/year · local-contact requirement</div>
              </div>
              <Button href="/resources/atlanta-short-term-rental-regulations/" variant="secondary" class="w-full text-center">Full Atlanta STR regulations guide &rarr;</Button>
            </div>
          </div>
        ) : (
          <div class="grid gap-8 lg:grid-cols-[2fr_1fr] lg:items-center">
            <div>
              <Eyebrow>Regulatory compliance</Eyebrow>
              <h2 class="mt-3 font-display text-2xl text-forest sm:text-3xl">{d.name} short-term rental rules — handled</h2>
              <p class="mt-4 text-ink/80">Short-term rental permitting in Georgia varies by city and county — licensing, occupancy taxes, and local rules differ from one market to the next. ATLStay helps every {d.name} owner navigate the local requirements and stay compliant, and we keep current as rules change.</p>
              <p class="mt-3 text-ink/80">Always confirm the latest rules with {d.name}'s local authority before you list — we'll point you to exactly what applies to your property.</p>
            </div>
            <Button href="/resources/atlanta-short-term-rental-regulations/" variant="secondary" class="self-start text-center">Georgia STR regulations guide &rarr;</Button>
          </div>
        )}
      </div>
    </Container>
  </Section>

  <!-- Nearby markets (internal linking) -->
  {nearby.length > 0 && (
    <Section variant="white">
      <Container>
        <div class="mb-8 text-center">
          <Eyebrow>{regionLabel}</Eyebrow>
          <h2 class="mt-3 font-display text-3xl text-forest sm:text-4xl">Nearby areas we manage</h2>
        </div>
        <div class="flex flex-wrap justify-center gap-3">
          {cityCounty && (
            <a href={`/counties/${cityCounty.slug}/`} class="rounded-full border border-brass/50 bg-brass-50 px-5 py-2.5 text-sm font-semibold text-brass-600 transition-colors hover:border-brass hover:bg-brass hover:text-forest-900">{cityCounty.name} County overview &rarr;</a>
          )}
          {nearby.filter((c) => !exploreHrefs.has(`/${c.data.slug}/`)).map((c) => (
            <a href={`/${c.data.slug}/`} class="rounded-full border border-line bg-cream px-5 py-2.5 text-sm text-forest transition-colors hover:border-brass hover:text-brass-600">{c.data.name}</a>
          ))}
          <a href="/areas-we-serve/" class="rounded-full bg-forest px-5 py-2.5 text-sm text-cream transition-colors hover:bg-forest-700">All areas &rarr;</a>
        </div>
      </Container>
    </Section>
  )}

  <!-- FAQ (emits FAQPage JSON-LD) -->
  {d.faqs.length > 0 && (
    <Section variant="cream">
      <Container size="narrow">
        <Eyebrow>Common questions</Eyebrow>
        <h2 class="mt-3 font-display text-3xl text-forest sm:text-4xl">{d.name} STR management — FAQs</h2>
        <div class="mt-8"><FAQ items={d.faqs} /></div>
      </Container>
    </Section>
  )}

  {citySvcs.length > 0 && (
    <Section variant="white">
      <Container>
        <Eyebrow>Every service we run here</Eyebrow>
        <h2 class="mt-3 font-display text-3xl text-forest sm:text-4xl">
          What we manage in {d.name}
        </h2>
        <p class="mt-4 max-w-2xl text-ink/75">
          {hasLongTerm
            ? `Short-term hosting is one part of it. Because licensed Georgia real estate professionals are on our team, we also handle leasing, long-term tenants and community associations in ${d.name} — work an unlicensed manager legally cannot take on.`
            : `Here is every service we run in ${d.name}, each with its own local detail.`}
        </p>
        {/* This block did not exist. City pages linked UP to hubs but never DOWN
            to their own service pages, so /marietta/ offered no route to
            /services/hoa-management/marietta/ despite it existing and matching
            exactly. Those pages depended on a single discovery path; this gives
            them a second one, and gives the reader the page they actually want. */}
        <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {citySvcs.map((s) => (
            <li>
              <a
                href={`/services/${s.slug}/${d.slug}/`}
                class="flex h-full flex-col rounded-2xl border border-line bg-white p-5 transition-colors hover:border-brass hover:bg-cream focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-forest"
              >
                <span class="font-display text-lg text-forest">{s.name}</span>
                <span class="mt-1.5 text-sm text-ink/70">in {d.name}, {d.state}</span>
              </a>
            </li>
          ))}
        </ul>
      </Container>
    </Section>
  )}

  {/* Second form instance. The hero form was the ONLY one on city pages —
      the best-performing shape on the site at ~14 impressions per page — so a
      reader who scrolled past the hero had no way to convert without going
      back up. ServiceFormBand hydrates client:visible, so this costs nothing
      on first paint. */}
  <CTABand heading={`Ready to maximize your ${d.name} property?`} text="Get a free, comps-based rental projection from our local team." />
</BaseLayout>
