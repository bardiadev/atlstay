---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '@fontsource-variable/bricolage-grotesque';
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import CallBar from '../components/layout/CallBar.astro';
import { site } from '../config/site';
import { pageTitle, clampDescription, canonical, absoluteImage, type SeoProps } from '../lib/seo';
import { organizationSchema, websiteSchema, localBusinessSchema, parentOrganizationSchema } from '../lib/schema';

interface Props extends SeoProps {
  /** Extra page-specific JSON-LD objects (breadcrumbs, article, service, faq…). */
  schemas?: unknown[];
  /** Hide header/footer for a focused landing page. */
  bare?: boolean;
}
const {
  title,
  description = site.description,
  image,
  ogType = 'website',
  noindex = false,
  schemas = [],
  bare = false,
} = Astro.props;

const fullTitle = pageTitle(title);
const canonicalUrl = canonical(Astro.url);
const ogImage = absoluteImage(image);
// Only the default OG image has known dimensions (1200×630). Custom per-page
// images vary, so we omit width/height there and let scrapers measure.
const usingDefaultOg = !image;
const metaDescription = clampDescription(description);

// Sitewide org/website/localbusiness once; pages add their own via `schemas`.
const allSchemas = [
  parentOrganizationSchema(),
  organizationSchema(),
  websiteSchema(),
  localBusinessSchema(),
  ...schemas,
].filter(Boolean);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {site.analytics?.gaId && (
      <Fragment>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.analytics.gaId}`}></script>
        <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${site.analytics.gaId}');`} />

        {/* CALL TRACKING.
            The owner reports roughly two calls a day; the lead forms account
            for about 0.9. More than half of all leads were arriving by phone
            with nothing recorded at all, so there was no way to know which
            pages actually produce calls — the largest channel on the site was
            invisible in every report.

            One delegated listener on the document rather than a listener per
            link: tel: links are rendered in the header, the footer, the sticky
            mobile bar and inside page copy, and several of those are re-rendered
            client-side. Delegation catches them all, including any added later.

            Deliberately defensive. It is wrapped so that a failure here can
            never break a phone call — the click proceeds regardless of whether
            gtag exists, has loaded yet, or throws. An analytics tag must never
            stand between a customer and the phone. */}
        <script is:inline set:html={`
(function(){
  try {
    document.addEventListener('click', function(e){
      try {
        var a = e.target && e.target.closest && e.target.closest('a[href^="tel:"]');
        if (!a || typeof window.gtag !== 'function') return;
        var where = a.closest('header') ? 'header'
                  : a.closest('footer') ? 'footer'
                  : a.closest('[data-sticky-cta]') ? 'sticky_bar'
                  : 'page_body';
        window.gtag('event', 'call_click', {
          event_category: 'lead',
          link_url: a.getAttribute('href') || '',
          page_path: location.pathname,
          placement: where
        });
      } catch (_) {}
    }, true);
  } catch (_) {}
})();`} />
      </Fragment>
    )}

    <link rel="canonical" href={canonicalUrl} />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.brandName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    {usingDefaultOg && (
      <Fragment>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </Fragment>
    )}
    <meta property="og:image:alt" content={`${site.brandName} — ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${site.brandName} — ${site.tagline}`} />

    <meta name="theme-color" content="#14342B" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* No web-app manifest on purpose. A manifest with `display: standalone`
        is exactly what makes Chrome, Edge and Safari offer to "install" the
        site as an app. ATLStay is a marketing website, not an app, and those
        install prompts were interrupting real visitors on the home page.
        Do not re-add a manifest link. (The PNG icons stay — apple-touch-icon
        is used for bookmarks and icon-512 for Organization schema logo.) */}
    <link rel="sitemap" href="/sitemap-index.xml" />

    {allSchemas.map((s) => <script type="application/ld+json" is:inline set:html={JSON.stringify(s)} />)}
    <slot name="head" />
  </head>
  <body class={bare ? '' : 'pb-16 xl:pb-0'}>
    {!bare && <a href="#main" class="skip-link">Skip to content</a>}
    {!bare && <Header />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}
    {!bare && <CallBar />}
  </body>
</html>
